@page "/settings"
@using PaperlessScanBridge.Application.Profiles
@using PaperlessScanBridge.Application.Scanning
@using PaperlessScanBridge.Application.Paperless
@using PaperlessScanBridge.Application.Configuration
@inject IProfileDefaultsService Profiles
@inject IProfileServiceConfigurationService ServiceConfiguration
@inject IScannerDiscoveryService Discovery
@inject IPaperlessClient Paperless
@inject PaperlessOptions PaperlessConfiguration
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Profile settings</PageTitle>
<header class="page-heading"><p class="eyebrow">Administration</p><h1>Settings</h1><p>Manage profiles, scanners, Paperless, and notifications.</p></header>
<ScannerSetup ScannerReady="ScannerReadyAsync" />
<section class="card mt-4 settings-panel">
 <div class="card-body">
  <h1 class="h2">Local profile</h1>
  <p>These defaults are stored locally in SQLite and copied as the starting point for every new scan session.</p>
  @if (loading) { <div class="alert alert-info" role="status">Loading settings …</div> }
  else
  {
   @if (errors.Count > 0) { <div class="alert alert-warning" role="alert"><strong>Please correct:</strong><ul class="mb-0">@foreach (var item in errors) { <li>@item</li> }</ul></div> }
   @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-success" role="status">@message</div> }
   <fieldset id="paperless-connection"><legend class="h4">Paperless connection</legend>
    <p class="text-muted">Effective source: URL <strong>@SourceName(effective?.UrlSource)</strong>, Token <strong>@SourceName(effective?.TokenSource)</strong>.</p>
    @if (PaperlessUsesHttp)
    {
     <div id="paperless-http-warning" class="alert alert-warning" role="alert"><strong>Unencrypted Paperless connection.</strong> HTTP does not protect the API token, metadata, or documents from being observed or changed in transit, even on a local network. Use HTTPS whenever possible.</div>
    }
    @if (serviceConfiguration.IsReadOnly)
    {
     <div class="alert alert-info" role="note">In anonymous mode these read-only values come from the environment variables <code>PAPERLESS_URL</code> and <code>PAPERLESS_TOKEN</code>. Changes must be made in the deployment environment and take effect after a restart.</div>
     <dl class="row g-3 mb-0" aria-label="Read-only Paperless configuration">
      <div class="col-12"><dt class="small text-secondary mb-1">Base URL from <code>PAPERLESS_URL</code></dt><dd id="paperless-url-value" class="bg-body-secondary border rounded px-3 py-2 mb-0 text-break">@paperlessUrl</dd></div>
      <div class="col-12"><dt class="small text-secondary mb-1">API token from <code>PAPERLESS_TOKEN</code></dt><dd id="paperless-token-status" class="bg-body-secondary border rounded px-3 py-2 mb-0"><span class="font-monospace" aria-hidden="true">@(serviceConfiguration.HasToken ? "••••••••••••" : "—")</span> <span class="ms-2">@(serviceConfiguration.HasToken ? "Configured; the secret is not sent to the browser." : "Not configured")</span></dd></div>
     </dl>
    }
    else
    {
     <div class="mb-3"><label class="form-label" for="paperless-url">Base URL</label><input id="paperless-url" class="form-control form-control-lg" @bind="paperlessUrl" disabled="@(!serviceConfiguration.AllowProfileUrlOverride)" placeholder="https://paperless.example.test" /><div class="form-text">@(serviceConfiguration.AllowProfileUrlOverride ? "Initially supplied by the administrator; saving creates your profile URL." : "Administrator-managed deployment configuration; profile URL changes are disabled.")</div></div>
     <div class="mb-3"><label class="form-label" for="paperless-token">Your profile API token</label><div class="input-group input-group-lg"><input id="paperless-token" type="@(showPaperlessToken ? "text" : "password")" autocomplete="off" class="form-control" @bind="paperlessToken" /><button id="toggle-paperless-token" type="button" class="btn btn-outline-secondary" @onclick="() => showPaperlessToken = !showPaperlessToken" aria-pressed="@showPaperlessToken">@(showPaperlessToken ? "Hide" : "Show")</button></div><div class="form-text">The token is encrypted at rest. Anyone with access to your active signed-in browser session can use Show to view it.</div></div>
     @if (serviceConfiguration.DeploymentTokenFallbackEnabled && serviceConfiguration.DeploymentTokenAvailable) { <div id="deployment-token-status" class="alert alert-info" role="note"><strong>Administrator-managed shared Paperless identity available.</strong> It is used only when your profile has no token. Uploads use the same Paperless account, and assignment and visibility depend on that shared account. Its token is never sent to your browser.</div> }
     else { <div id="deployment-token-status" class="alert alert-secondary" role="note">Administrator-managed token fallback is disabled or unavailable. Only an administrator can change this policy.</div> }
     <button id="save-paperless" class="btn btn-outline-primary w-100" @onclick="SaveServiceAsync" disabled="@serviceSaving">@(serviceSaving ? "Checking connection …" : "Save token and check connection")</button>
     @if (serviceConfiguration.HasToken) { <button id="remove-paperless-token" class="btn btn-outline-danger w-100 mt-2" @onclick="RemoveTokenAsync" disabled="@serviceSaving">Remove my saved profile token</button> }
    }
   </fieldset>
   <fieldset class="mt-4"><legend class="h4">Scan defaults</legend>
    @if (scanners.Count > 0)
    {
     <div class="mb-4" aria-labelledby="saved-scanners-title">
      <h2 id="saved-scanners-title" class="h5">Saved scanners</h2>
      @foreach (var scanner in scanners)
      {
       <article class="border rounded p-3 mb-2" aria-busy="@(forgettingId == scanner.Id)">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
         <div><strong>@scanner.DisplayName</strong><div class="text-body-secondary">@scanner.IpAddress · @scanner.Protocol.ToUpperInvariant()</div></div>
         <button class="btn btn-outline-danger" disabled="@(forgettingId is not null)" @onclick="() => confirmForgetId = scanner.Id">Forget scanner</button>
        </div>
        @if (confirmForgetId == scanner.Id)
        {
         <div class="alert alert-warning mt-3 mb-0" role="alert">
          <p><strong>Forget @scanner.DisplayName?</strong></p>
          <p>This clears its saved selection and cached capabilities, repairs every profile default that references it, and removes or updates Scan Bridge's generated scanner-backend configuration. Other scanners and unrelated system configuration are not changed.</p>
          <button class="btn btn-danger me-2" disabled="@(forgettingId is not null)" @onclick="() => ForgetAsync(scanner.Id)">
           @if (forgettingId == scanner.Id) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }@(forgettingId == scanner.Id ? "Forgetting scanner …" : "Confirm forget")
          </button>
          <button class="btn btn-outline-secondary" disabled="@(forgettingId is not null)" @onclick="() => confirmForgetId = null">Keep scanner</button>
         </div>
        }
       </article>
      }
     </div>
    }
    <div class="mb-3"><label class="form-label" for="default-scanner">Scanner</label><select id="default-scanner" class="form-select form-select-lg" @bind="scannerId" @bind:after="ScannerChanged"><option value="">No default scanner</option>@foreach (var scanner in scanners) { <option value="@scanner.Id">@scanner.DisplayName (@scanner.IpAddress)</option> }</select></div>
    <div class="mb-3"><label class="form-label" for="default-source">Source</label><select id="default-source" class="form-select form-select-lg" @bind="source" disabled="@(SelectedScanner is null)"><option value="">Select a source …</option>@foreach (var item in SelectedScanner?.Sources ?? []) { <option value="@item">@item</option> }</select></div>
    <div class="row g-3"><div class="col-12 col-md-6"><label class="form-label" for="default-color">Color mode</label><select id="default-color" class="form-select form-select-lg" @bind="colorMode"><option value="Color">Color</option><option value="Grayscale">Grayscale</option><option value="BlackAndWhite">Black and white</option></select></div>
    <div class="col-12 col-md-6"><label class="form-label" for="default-resolution">Resolution</label><select id="default-resolution" class="form-select form-select-lg" @bind="resolution">@foreach (var dpi in SelectedScanner?.Resolutions ?? [100, 200, 300, 600]) { <option value="@dpi">@dpi dpi</option> }</select></div></div>
   </fieldset>
   <fieldset class="mt-4"><legend class="h4">Upload defaults</legend>
    <div class="mb-3"><label class="form-label" for="default-title">Title</label><input id="default-title" class="form-control form-control-lg" @bind="title" /></div>
    <button class="btn btn-outline-secondary w-100 mb-3" @onclick="LoadMetadataAsync" disabled="@metadataLoading">@(metadataLoading ? "Checking Paperless …" : "Check Paperless connection and load choices")</button>
    @if (metadata is not null)
    {
     <div class="mb-3"><label class="form-label" for="default-correspondent">Correspondent</label><select id="default-correspondent" class="form-select" @bind="correspondentId"><option value="">No default</option>@foreach (var item in metadata.Correspondents) { <option value="@item.Id">@item.Name</option> }</select></div>
     <div class="mb-3"><label class="form-label" for="default-document-type">Document type</label><select id="default-document-type" class="form-select" @bind="documentTypeId"><option value="">No default</option>@foreach (var item in metadata.DocumentTypes) { <option value="@item.Id">@item.Name</option> }</select></div>
     <div><span class="form-label d-block">Tags</span>@foreach (var item in metadata.Tags) { <div class="form-check"><input class="form-check-input" type="checkbox" id="tag-@item.Id" checked="@tagIds.Contains(item.Id)" @onchange="args => ToggleTag(item.Id, args)" /><label class="form-check-label" for="tag-@item.Id">@item.Name</label></div> }</div>
    }
   </fieldset>
   <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="SaveAsync">Save defaults</button>
   <button class="btn btn-outline-danger w-100 mt-2" @onclick="ResetAsync">Reset to factory defaults</button>
  }
 </div>
</section>
<section class="card mt-4 notification-panel">
 <div class="card-body">
  <h2 class="h4">Browser notifications</h2>
  <p>Notify this browser tab when a stack must be flipped, a decision is needed, or a scan finishes while the open tab is in the background.</p>
  @if (notificationState == "enabled") { <button class="btn btn-outline-secondary w-100" @onclick="DisableNotificationsAsync">Disable notifications</button> }
  else { <button class="btn btn-outline-primary w-100" disabled="@(notificationState is "unsupported" or "denied")" @onclick="EnableNotificationsAsync">Enable notifications</button> }
  @if (notificationState == "denied") { <div class="alert alert-warning mt-3 mb-0">Notifications are blocked by the browser. Allow them in the site settings.</div> }
  else if (notificationState == "unsupported") { <div class="alert alert-warning mt-3 mb-0">This browser does not support notifications.</div> }
 </div>
</section>

@code {
 private bool loading = true, metadataLoading, serviceSaving, showPaperlessToken; private string? message, source, title; private long? scannerId, confirmForgetId, forgettingId; private int resolution = 300; private ScanColorMode colorMode = ScanColorMode.Color;
 private string? paperlessUrl, paperlessToken; private string notificationState = "disabled"; private IJSObjectReference? notificationModule; private ProfileServiceConfiguration serviceConfiguration = new(null,false,false,true,DateTimeOffset.MinValue); private EffectivePaperlessConfiguration? effective;
 private int? correspondentId, documentTypeId; private readonly HashSet<int> tagIds = []; private IReadOnlyList<string> errors = []; private IReadOnlyList<SelectedScanner> scanners = []; private PaperlessMetadata? metadata;
 private SelectedScanner? SelectedScanner => scanners.FirstOrDefault(value => value.Id == scannerId);
 private bool PaperlessUsesHttp => PaperlessConfiguration.ShowHttpWarning && (PaperlessUrlPolicy.IsUnencrypted(paperlessUrl) || PaperlessUrlPolicy.IsUnencrypted(effective?.BaseUrl));
 protected override async Task OnInitializedAsync() { scanners = await Discovery.GetSavedAsync(default); Apply(await Profiles.GetAsync()); serviceConfiguration = await ServiceConfiguration.GetAsync(); effective = await ServiceConfiguration.GetEffectiveAsync(); paperlessUrl=serviceConfiguration.BaseUrl; paperlessToken=serviceConfiguration.ApiToken; loading = false; }
 protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; notificationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./scanNotifications.js"); notificationState = await notificationModule.InvokeAsync<string>("getState"); StateHasChanged(); }
 private async Task EnableNotificationsAsync() { if (notificationModule is not null) notificationState = await notificationModule.InvokeAsync<string>("enable"); }
 private async Task DisableNotificationsAsync() { if (notificationModule is not null) notificationState = await notificationModule.InvokeAsync<string>("disable"); }
 public async ValueTask DisposeAsync() { if (notificationModule is not null) try { await notificationModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
 private void Apply(ProfileDefaults value) { scannerId=value.ScannerId; source=value.Source; colorMode=value.ColorMode; resolution=value.ResolutionDpi; title=value.Title; correspondentId=value.CorrespondentId; documentTypeId=value.DocumentTypeId; tagIds.Clear(); tagIds.UnionWith(value.TagIds); }
 private void ScannerChanged() { source = SelectedScanner?.Sources?.FirstOrDefault(); resolution = SelectedScanner?.Resolutions?.Contains(300) == true ? 300 : SelectedScanner?.Resolutions?.FirstOrDefault() ?? 300; }
 private Task ScannerReadyAsync(SelectedScanner scanner) { scanners = scanners.Where(value => value.Id != scanner.Id).Append(scanner).ToArray(); scannerId = scanner.Id; ScannerChanged(); return Task.CompletedTask; }
 private async Task SaveServiceAsync() { serviceSaving=true; message=null; errors=[]; var result=await ServiceConfiguration.ValidateAndSaveAsync(new(paperlessUrl,paperlessToken,true,false,false)); errors=result.Errors; if(result.Succeeded){ serviceConfiguration=result.Configuration; effective=await ServiceConfiguration.GetEffectiveAsync(); metadata=result.Metadata; paperlessToken=result.Configuration.ApiToken; showPaperlessToken=false; message="Paperless configuration was validated and activated."; } serviceSaving=false; }
 private async Task RemoveTokenAsync() { serviceSaving=true; await ServiceConfiguration.DeleteAsync(); serviceConfiguration=await ServiceConfiguration.GetAsync(); effective=await ServiceConfiguration.GetEffectiveAsync(); paperlessToken=null; showPaperlessToken=false; message="Your saved profile token was removed."; serviceSaving=false; }
 private static string SourceName(PaperlessConfigurationSource? source) => source switch { PaperlessConfigurationSource.Profile => "Profile", PaperlessConfigurationSource.Deployment => "Deployment", _ => "not configured" };
 private async Task LoadMetadataAsync() { metadataLoading=true; errors=[]; var result=await Paperless.GetMetadataAsync(); metadata=result.Metadata; if (!result.Result.Succeeded) errors=[result.Result.Message]; else ValidatePaperlessChoices(); metadataLoading=false; }
 private void ValidatePaperlessChoices() { if (metadata is null) return; var list=new List<string>(); if (correspondentId is { } c && metadata.Correspondents.All(x=>x.Id!=c)) list.Add("The saved correspondent no longer exists in Paperless."); if (documentTypeId is { } d && metadata.DocumentTypes.All(x=>x.Id!=d)) list.Add("The saved document type no longer exists in Paperless."); foreach(var id in tagIds.Where(id=>metadata.Tags.All(x=>x.Id!=id))) list.Add($"The saved tag {id} no longer exists in Paperless."); errors=list; }
 private void ToggleTag(int id, ChangeEventArgs args) { if(args.Value is true) tagIds.Add(id); else tagIds.Remove(id); }
 private async Task SaveAsync() { message=null; ValidatePaperlessChoices(); if(errors.Count>0)return; var result=await Profiles.SaveAsync(new(scannerId,source,colorMode,resolution,title,correspondentId,documentTypeId,tagIds.ToArray(),DateTimeOffset.UtcNow)); errors=result.Errors; if(result.IsValid)message="The defaults were saved."; }
 private async Task ResetAsync() { await Profiles.ResetAsync(); Apply(await Profiles.GetAsync()); metadata=null; errors=[]; message="All defaults were reset."; }
 private async Task ForgetAsync(long id) { forgettingId=id; message=null; errors=[]; try { var result=await Discovery.ForgetAsync(id,default); if(result.Succeeded){ scanners=await Discovery.GetSavedAsync(default); Apply(await Profiles.GetAsync()); confirmForgetId=null; message=result.Message; } else errors=[result.Message]; } finally { forgettingId=null; } }
}
