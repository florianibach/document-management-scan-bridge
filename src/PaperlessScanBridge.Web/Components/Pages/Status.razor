@page "/status"
@inject BuildInformation Build
<PageTitle>Status</PageTitle>
<header class="page-heading"><p class="eyebrow">Operations &amp; diagnostics</p><h1>Status</h1><p>Technical information is intentionally separated from the daily scan workflow.</p></header>
<div class="row g-3">
 <div class="col-12 col-lg-6"><AppStateCard Kind="success" Title="Application ready" Message="The public health endpoint can be checked by Compose and monitoring."><ChildContent><a class="btn btn-outline-primary" href="/health">Open health check</a></ChildContent></AppStateCard></div>
 <div class="col-12 col-lg-6"><AppStateCard Kind="empty" Title="Version" Message="@($"Installed build: {Build.Commit}")"><TechnicalDetails>This value is the Git commit supplied during the container build.</TechnicalDetails></AppStateCard></div>
 <div class="col-12"><AppStateCard Kind="warning" Title="Network diagnostics" Message="Scanner discovery requires mDNS on the local network."><TechnicalDetails>UDP 5353 and eSCL access to the scanner must be reachable. Capabilities are validated on selection.</TechnicalDetails></AppStateCard></div>
</div>
