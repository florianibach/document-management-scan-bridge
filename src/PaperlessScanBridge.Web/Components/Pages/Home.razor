@page "/"
@using PaperlessScanBridge.Application.Scanning
@inject IScannerDiscoveryService Discovery
@inject IScanner Scanner
@inject ISimplexScanWorkflow ScanWorkflow
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Scanner auswählen</PageTitle>
<div class="container-fluid px-0">
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-body-tertiary">
        <span class="badge text-bg-primary mb-3">Scannerkonfiguration</span>
        <h1 class="display-6 fw-bold">Netzwerkscanner auswählen</h1>
        <p class="lead">Sucht eSCL/AirScan-Geräte direkt per mDNS und prüft den ausgewählten Scanner.</p>
        <button class="btn btn-primary btn-lg w-100 w-md-auto" @onclick="DiscoverAsync" disabled="@loading">
            @(loading ? "Suche läuft …" : "Scanner suchen")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(error ? "alert-warning" : "alert-success")" role="alert">@message</div> }
    @if (result is null) { <div class="alert alert-info" role="status">Noch keine Suche ausgeführt.</div> }
    else if (result.Devices.Count == 0) { <div class="alert alert-warning" role="alert">@string.Join(" ", result.Diagnostics)</div> }
    else
    {
        @foreach (var diagnostic in result.Diagnostics) { <div class="alert alert-info" role="status">@diagnostic</div> }
        <fieldset class="row g-3 mb-3">
            <legend class="h4">Gefundene Scanner</legend>
            @foreach (var device in result.Devices)
            {
                <div class="col-12 col-md-6">
                    <label class="card h-100 scanner-choice @(selectedId == device.DiscoveryId ? "border-primary" : "")">
                        <div class="card-body">
                            <input type="radio" name="scanner" value="@device.DiscoveryId" checked="@(selectedId == device.DiscoveryId)" @onchange="() => selectedId = device.DiscoveryId" />
                            <strong class="ms-2">@device.DisplayName</strong>
                            <div class="mt-2"><span class="badge text-bg-secondary">@device.Protocol.ToUpperInvariant()</span> @device.IpAddress:@device.Port</div>
                        </div>
                    </label>
                </div>
            }
        </fieldset>
        <button class="btn btn-success btn-lg w-100" disabled="@(loading || selectedId is null)" @onclick="SelectAsync">Scanner auswählen</button>
    }

    @if (saneResult?.Succeeded == true)
    {
        <section class="card mt-4"><div class="card-body">
            <h2 class="h4">@saneResult.SelectedDevice!.DisplayName</h2>
            <div class="row g-3">
                <Capability Title="Einzugsquellen" Values="saneResult.Capabilities!.Sources" />
                <Capability Title="Formate" Values="saneResult.Capabilities.Formats" />
                <Capability Title="Auflösungen" Values="ResolutionLabels" />
                <Capability Title="Papiergrößen" Values="saneResult.Capabilities.PaperSizes" />
            </div>
        </div></section>
    }
</div>

<section class="card mt-4 scan-panel">
 <div class="card-body">
  <span class="badge text-bg-primary mb-2">Simplex</span>
  <h2 class="h3">Dokument scannen</h2>
  <p>Eine Seite vom Vorlagenglas oder mehrere einseitige Seiten über den Einzug erfassen.</p>
  @if (savedScanners.Count == 0)
  {
   <div class="alert alert-warning">Noch kein gespeicherter Scanner vorhanden. Bitte zuerst oben einen Scanner suchen und auswählen.</div>
  }
  else
  {
   <div class="mb-3"><label class="form-label" for="saved-scanner">Gespeicherter Scanner</label><select id="saved-scanner" class="form-select form-select-lg" @bind="activeScannerId" @bind:after="ActivateSelectedScannerAsync" disabled="@IsScanning"><option value="">Scanner auswählen …</option>@foreach (var scanner in savedScanners) { <option value="@scanner.Id">@scanner.DisplayName (@scanner.IpAddress)</option> }</select></div>
   @if (activeScannerId is null) { <div class="alert alert-info">Scanner auswählen, um dessen aktuelle Einzugsquellen und Scanoptionen abzufragen.</div> }
  }
  <div class="row g-3">
   <div class="col-12 col-md-4"><label class="form-label" for="source">Quelle</label><select id="source" class="form-select form-select-lg" @bind="scanSource" disabled="@(IsScanning || availableSources.Count == 0)">@foreach (var source in availableSources) { <option value="@source">@SourceLabel(source)</option> }</select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="color">Farbmodus</label><select id="color" class="form-select form-select-lg" @bind="colorMode" disabled="@IsScanning"><option value="Color">Farbe</option><option value="Grayscale">Graustufen</option><option value="BlackAndWhite">Schwarzweiß</option></select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="resolution">Auflösung</label><select id="resolution" class="form-select form-select-lg" @bind="resolution" disabled="@IsScanning"><option value="100">100 dpi</option><option value="200">200 dpi</option><option value="300">300 dpi</option><option value="600">600 dpi</option></select></div>
  </div>
  <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="StartScanAsync" disabled="@(IsScanning || string.IsNullOrWhiteSpace(activeDeviceId) || string.IsNullOrWhiteSpace(scanSource))">@(IsScanning ? "Scan läuft …" : "Simplex-Scan starten")</button>
  @if (IsScanning) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Scan abbrechen</button> }
  @if (ScanWorkflow.Current is { } job) { <div class="alert @StatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@StatusLabel:</strong> @job.Message</div> }
 </div>
</section>

@code {
    private ScannerNetworkDiscoveryResult? result;
    private ScannerDiscoveryResult? saneResult;
    private string? selectedId;
    private string? message;
    private bool error;
    private bool loading;
    private IReadOnlyList<SelectedScanner> savedScanners = [];
    private IReadOnlyList<string> availableSources = [];
    private long? activeScannerId;
    private string? activeDeviceId;
    private string scanSource = "";
    private ScanColorMode colorMode = ScanColorMode.Color;
    private int resolution = 300;
    private bool IsScanning => ScanWorkflow.Current?.IsActive == true;
    private string StatusLabel => ScanWorkflow.Current?.State switch { ScanJobState.Queued => "Eingereiht", ScanJobState.Running => "Läuft", ScanJobState.Completed => "Abgeschlossen", ScanJobState.Cancelled => "Abgebrochen", _ => "Fehlgeschlagen" };
    private string StatusClass => ScanWorkflow.Current?.State switch { ScanJobState.Completed => "alert-success", ScanJobState.Failed => "alert-danger", ScanJobState.Cancelled => "alert-warning", _ => "alert-info" };

    protected override async Task OnInitializedAsync()
    {
        ScanWorkflow.Changed += OnScanChanged;
        savedScanners = await Discovery.GetSavedAsync(CancellationToken.None);
    }
    private void OnScanChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task StartScanAsync() => await ScanWorkflow.StartAsync(new(activeDeviceId!, scanSource, colorMode, resolution));
    private Task CancelScanAsync() => ScanWorkflow.CancelAsync();
    public void Dispose() => ScanWorkflow.Changed -= OnScanChanged;
    private static string SourceLabel(string source) => source.Contains("ADF", StringComparison.OrdinalIgnoreCase) || source.Contains("Feeder", StringComparison.OrdinalIgnoreCase) ? $"Automatischer Einzug ({source})" : $"Vorlagenglas ({source})";

    private async Task ActivateSelectedScannerAsync()
    { if (activeScannerId is { } id) await ActivateScannerAsync(id); }

    private async Task ActivateScannerAsync(long id)
    {
        message = null;
        var activation = await Discovery.ActivateSavedAsync(id, CancellationToken.None);
        if (!activation.Succeeded) { error = true; message = activation.Diagnostic; return; }
        activeScannerId = id;
        saneResult = await Scanner.DiscoverAsync(CancellationToken.None);
        if (!saneResult.Succeeded || saneResult.SelectedDevice is null || saneResult.Capabilities is null)
        { error = true; message = saneResult.Diagnostic; activeDeviceId = null; availableSources = []; return; }
        activeDeviceId = saneResult.SelectedDevice.Identifier;
        availableSources = saneResult.Capabilities.Sources;
        scanSource = availableSources.FirstOrDefault(value => value.Contains("ADF", StringComparison.OrdinalIgnoreCase) || value.Contains("Feeder", StringComparison.OrdinalIgnoreCase))
            ?? availableSources.FirstOrDefault() ?? "";
        error = false;
        message = $"{activation.Scanner!.DisplayName} ist für den Scan aktiviert.";
    }
    private IReadOnlyList<string> ResolutionLabels => saneResult?.Capabilities?.Resolutions.Select(value => $"{value} dpi").ToArray() ?? [];

    private async Task DiscoverAsync()
    {
        loading = true; message = null; selectedId = null;
        try { result = await Discovery.DiscoverAsync(CancellationToken.None); }
        finally { loading = false; }
    }

    private async Task SelectAsync()
    {
        loading = true; message = null;
        try
        {
            var selection = await Discovery.SelectAsync(selectedId!, CancellationToken.None);
            error = !selection.Succeeded;
            message = selection.Succeeded ? selection.Diagnostic ?? $"{selection.Scanner!.DisplayName} wurde geprüft und gespeichert." : selection.Diagnostic;
            if (selection.Succeeded)
            {
                savedScanners = await Discovery.GetSavedAsync(CancellationToken.None);
                await ActivateScannerAsync(selection.Scanner!.Id);
                message = selection.Diagnostic ?? $"{selection.Scanner.DisplayName} wurde geprüft und gespeichert und ist für den Scan aktiviert.";
            }
        }
        finally { loading = false; }
    }
}
