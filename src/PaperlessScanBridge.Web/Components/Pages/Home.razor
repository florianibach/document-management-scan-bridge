@page "/"
@using PaperlessScanBridge.Application.Scanning
@using PaperlessScanBridge.Application.Documents
@using PaperlessScanBridge.Application.Paperless
@using PaperlessScanBridge.Application.Profiles
@inject IScannerDiscoveryService Discovery
@inject IScanner Scanner
@inject ISimplexScanWorkflow ScanWorkflow
@inject IManualDuplexWorkflow DuplexWorkflow
@inject IPageEditingSession PageEditor
@inject IPdfCreationWorkflow PdfWorkflow
@inject IPaperlessClient PaperlessClient
@inject IPaperlessUploadWorkflow UploadWorkflow
@inject IProfileDefaultsService Profiles
@inject IScanSessionAccessService SessionAccess
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Scanner auswählen</PageTitle>
<section class="card mt-4 scan-panel">
 <div class="card-body">
  <span class="badge text-bg-primary mb-2">Simplex</span>
  <h2 class="h3">Dokument scannen</h2>
  <p>Eine Seite vom Vorlagenglas oder mehrere einseitige Seiten über den Einzug erfassen.</p>
  @if (savedScanners.Count == 0)
  {
   <div class="alert alert-warning">Noch kein gespeicherter Scanner vorhanden. Bitte zuerst oben einen Scanner suchen und auswählen.</div>
  }
  else
  {
   <div class="mb-3"><label class="form-label" for="saved-scanner">Gespeicherter Scanner</label><select id="saved-scanner" class="form-select form-select-lg" @bind="activeScannerId" @bind:after="ActivateSelectedScannerAsync" disabled="@(IsScanning || scannerLoading)"><option value="">Scanner auswählen …</option>@foreach (var scanner in savedScanners) { <option value="@scanner.Id">@scanner.DisplayName (@scanner.IpAddress)</option> }</select></div>
   @if (activeScannerId is null) { <div class="alert alert-info">Scanner auswählen, um dessen aktuelle Einzugsquellen und Scanoptionen abzufragen.</div> }
   @if (scannerLoading) { <div class="alert alert-info d-flex align-items-center gap-2" role="status" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>SANE sucht den Scanner und liest seine Optionen mit <code>scanimage</code> …</span></div> }
  }
  @if (!string.IsNullOrWhiteSpace(activeDeviceId))
  {
  <button class="btn btn-outline-secondary w-100 mb-3" @onclick="RefreshSaneAsync" disabled="@(IsScanning || scannerLoading)">Scannerwerte aktualisieren</button>
  <div class="row g-3">
   <div class="col-12 col-md-4"><label class="form-label" for="source">Quelle</label><select id="source" class="form-select form-select-lg" value="@scanSource" @onchange="ChangeSource" disabled="@(IsScanning || availableSources.Count == 0)">@foreach (var source in availableSources) { <option value="@source" selected="@(source == scanSource)">@SourceLabel(source)</option> }</select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="color">Farbmodus</label><select id="color" class="form-select form-select-lg" value="@colorMode" @onchange="ChangeColorMode" disabled="@IsScanning"><option value="Color" selected="@(colorMode == ScanColorMode.Color)">Farbe</option><option value="Grayscale" selected="@(colorMode == ScanColorMode.Grayscale)">Graustufen</option><option value="BlackAndWhite" selected="@(colorMode == ScanColorMode.BlackAndWhite)">Schwarzweiß</option></select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="resolution">Auflösung</label><select id="resolution" class="form-select form-select-lg" value="@resolution" @onchange="ChangeResolution" disabled="@IsScanning"><option value="100" selected="@(resolution == 100)">100 dpi</option><option value="200" selected="@(resolution == 200)">200 dpi</option><option value="300" selected="@(resolution == 300)">300 dpi</option><option value="600" selected="@(resolution == 600)">600 dpi</option></select></div>
  </div>
  }
  <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="StartScanAsync" disabled="@(IsScanning || DuplexWorkflow.Current?.IsActive == true || string.IsNullOrWhiteSpace(activeDeviceId) || string.IsNullOrWhiteSpace(scanSource))">@(IsScanning ? "Scan läuft …" : "Simplex-Scan starten")</button>
  @if (ScanWorkflow.Current?.State == ScanJobState.AwaitingUserDecision)
  {
   <button class="btn btn-success btn-lg w-100 mt-2" @onclick="ContinueScanAsync">Scanner arbeitet noch – weiter warten</button>
   <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Scan jetzt abbrechen</button>
  }
  else if (IsScanning) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Scan abbrechen</button> }
  @if (ScanWorkflow.Current is { } job) { <div class="alert @StatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@StatusLabel:</strong> @job.Message</div> }
 </div>
</section>

<section class="card mt-4 scan-panel duplex-panel">
 <div class="card-body">
  <span class="badge text-bg-success mb-2">Manueller Duplex</span>
  <h2 class="h3">Beidseitiges Dokument scannen</h2>
  <p>Zwei kontrollierte Einzugsdurchläufe werden anschließend automatisch in Lesereihenfolge gebracht.</p>
  @if (!HasAdf)
  {
   <div class="alert alert-warning">Für manuellen Duplex bitte einen Scanner mit automatischem Einzug auswählen.</div>
  }
  else
  {
   <div class="alert alert-info mb-3"><strong>Verwendete Einstellungen:</strong> Automatischer Einzug (@DuplexSource), @ColorModeLabel, @resolution dpi. Die oben gewählten Farb- und Auflösungswerte gelten für beide Durchläufe.</div>
  }
  @if (HasAdf && DuplexWorkflow.Current?.State == ManualDuplexState.AwaitingFlipConfirmation)
  {
   <div class="flip-instruction" role="status" aria-live="polite">
    <div class="flip-icon" aria-hidden="true">↶</div>
    <h3 class="h4">Stapel jetzt wenden</h3>
    <ol><li>Den vollständigen Stapel aus dem Ausgabefach nehmen.</li><li>Den Stapel geschlossen wenden – Reihenfolge nicht verändern.</li><li>Mit der ungescannten Seite in derselben Einzugsrichtung wieder einlegen.</li></ol>
   </div>
   <div class="form-check my-3"><input id="blank-back" class="form-check-input" type="checkbox" @bind="finalBackIsBlank"><label class="form-check-label" for="blank-back">Die allerletzte Rückseite des Dokuments ist leer</label></div>
   <button class="btn btn-success btn-lg w-100" @onclick="ConfirmFlipAsync">Stapel liegt richtig – Rückseiten scannen</button>
   <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelDuplexAsync">Duplex-Scan abbrechen</button>
  }
  else if (HasAdf)
  {
   <button class="btn btn-success btn-lg w-100" @onclick="StartDuplexAsync" disabled="@(!HasAdf || IsScanning || DuplexWorkflow.Current?.IsActive == true)">@(DuplexWorkflow.Current?.IsActive == true ? "Duplex-Scan läuft …" : "Manuellen Duplex-Scan starten")</button>
   @if (DuplexWorkflow.Current?.State is ManualDuplexState.ScanningFronts or ManualDuplexState.ScanningBacks) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelDuplexAsync">Duplex-Scan abbrechen</button> }
   @if (DuplexWorkflow.Current?.State == ManualDuplexState.PageCountMismatch) { <button class="btn btn-warning btn-lg w-100 mt-2" @onclick="RestartDuplexAsync">Stapel prüfen und neu starten</button> }
  }
  @if (DuplexWorkflow.Current is { } duplex) { <div class="alert @DuplexStatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@DuplexStatusLabel:</strong> @duplex.Message</div> }
 </div>
</section>


@if (PageEditor.Current is { } preview)
{
 <section class="card mt-4 preview-panel" aria-labelledby="preview-title">
  <div class="card-body">
   <h2 id="preview-title" class="h3">Seiten prüfen und bearbeiten</h2>
   <p>Drehungen und Löschungen gelten nur für diese Sitzung; die unveränderten Quelldateien bleiben erhalten.</p>
   @if (preview.Pages.Count == 0)
   {
    <div class="alert alert-warning" role="status">@preview.Message</div>
   }
   else
   {
    <div class="preview-grid">
     @foreach (var scannedPage in preview.Pages)
     {
      <article class="preview-page" aria-label="@("Seite " + scannedPage.Number)">
       <h3 class="h5">Seite @scannedPage.Number</h3>
       @if (scannedPage.IsAvailable)
       {
        <div class="preview-image-frame"><img loading="lazy" src="@PageUrl(preview.SessionId, scannedPage.FileName)" alt="@("Vorschau von Seite " + scannedPage.Number)" style="transform: rotate(@(scannedPage.RotationDegrees)deg)" /></div>
        <button class="btn btn-outline-primary w-100 mt-2" @onclick="() => PageEditor.Rotate(scannedPage.Id)" aria-label="@("Seite um 90 Grad drehen")">↻ 90° drehen</button>
       }
       else
       {
        <div class="alert alert-warning" role="alert">@scannedPage.Error</div>
       }
       @if (deleteCandidate == scannedPage.Id)
       {
        <div class="d-flex gap-2 mt-2"><button class="btn btn-danger flex-fill" @onclick="() => ConfirmDelete(scannedPage.Id)">Löschen bestätigen</button><button class="btn btn-outline-secondary flex-fill" @onclick="CancelDelete">Abbrechen</button></div>
       }
       else
       {
        <button class="btn btn-outline-danger w-100 mt-2" @onclick="() => RequestDelete(scannedPage.Id)">Seite löschen …</button>
       }
      </article>
     }
    </div>
    <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="CreatePdfAsync" disabled="@(PdfWorkflow.Current?.IsActive == true || preview.Pages.Any(page => !page.IsAvailable))">PDF erstellen</button>
    @if (PdfWorkflow.Current?.IsActive == true)
    {
     <button class="btn btn-outline-danger w-100 mt-2" @onclick="CancelPdfAsync">PDF-Erstellung abbrechen</button>
    }
    @if (PdfWorkflow.Current is { } pdf)
    {
     <div class="alert @PdfStatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@PdfStatusLabel:</strong> @pdf.Message
      @if (pdf.State == PdfCreationState.Completed) { <a class="btn btn-success w-100 mt-2" href="@PdfUrl(pdf.SessionId)">PDF herunterladen</a> }
     </div>
    }
    @if (PdfWorkflow.Current is { State: PdfCreationState.Completed } completed)
    {
     <hr class="my-4" />
     <h3 class="h4">An Paperless-ngx senden</h3>
     <button class="btn btn-outline-primary w-100" @onclick="LoadPaperlessAsync" disabled="@paperlessLoading">@(paperlessLoading ? "Verbindung wird geprüft …" : "Verbindung prüfen und Metadaten laden")</button>
     @if (!string.IsNullOrWhiteSpace(paperlessMessage)) { <div class="alert @(paperlessError ? "alert-danger" : "alert-success") mt-2" role="status">@paperlessMessage</div> }
     @if (paperlessMetadata is not null)
     {
      <div class="mt-3"><label class="form-label" for="paperless-title">Titel (optional)</label><input id="paperless-title" class="form-control form-control-lg" maxlength="256" @bind="paperlessTitle" /></div>
      <div class="mt-3"><label class="form-label" for="paperless-correspondent">Korrespondent (optional)</label><select id="paperless-correspondent" class="form-select form-select-lg" @bind="paperlessCorrespondent"><option value="">Nicht festlegen</option>@foreach (var choice in paperlessMetadata.Correspondents) { <option value="@choice.Id">@choice.Name</option> }</select></div>
      <div class="mt-3"><label class="form-label" for="paperless-type">Dokumenttyp (optional)</label><select id="paperless-type" class="form-select form-select-lg" @bind="paperlessDocumentType"><option value="">Nicht festlegen</option>@foreach (var choice in paperlessMetadata.DocumentTypes) { <option value="@choice.Id">@choice.Name</option> }</select></div>
      <fieldset class="mt-3"><legend class="h6">Tags (optional)</legend>@if (paperlessMetadata.Tags.Count == 0) { <p class="text-body-secondary">Keine Tags vorhanden.</p> }@foreach (var choice in paperlessMetadata.Tags) { <div class="form-check"><input class="form-check-input" id="paperless-tag-@choice.Id" type="checkbox" checked="@paperlessTags.Contains(choice.Id)" @onchange="args => ToggleTag(choice.Id, args)" /><label class="form-check-label" for="paperless-tag-@choice.Id">@choice.Name</label></div> }</fieldset>
      <button class="btn btn-success btn-lg w-100 mt-4" @onclick="() => UploadAsync(completed.SessionId)" disabled="@(UploadWorkflow.Current?.IsActive == true || UploadWorkflow.Current is { State: PaperlessUploadState.Accepted, SessionId: var accepted } && accepted == completed.SessionId)">An Paperless senden</button>
      @if (UploadWorkflow.Current?.IsActive == true) { <progress class="w-100 mt-3" max="100" value="@UploadWorkflow.Current.ProgressPercent">@UploadWorkflow.Current.ProgressPercent%</progress><button class="btn btn-outline-danger w-100 mt-2" @onclick="UploadWorkflow.CancelAsync">Upload abbrechen</button> }
      @if (UploadWorkflow.Current is { } upload) { <div class="alert @(upload.State == PaperlessUploadState.Accepted ? "alert-success" : upload.State == PaperlessUploadState.Failed ? "alert-danger" : "alert-info") mt-3" role="status">@upload.Message@if (!string.IsNullOrWhiteSpace(upload.TaskId)) { <div><small>Paperless-Auftrags-ID: @upload.TaskId</small></div> }</div> }
     }
    }
   }
  </div>
 </section>
}

<div class="container-fluid px-0">
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-body-tertiary">
        <span class="badge text-bg-primary mb-3">Scannerkonfiguration</span>
        <h1 class="display-6 fw-bold">Netzwerkscanner auswählen</h1>
        <p class="lead">Sucht eSCL/AirScan-Geräte direkt per mDNS und prüft den ausgewählten Scanner.</p>
        <button class="btn btn-primary btn-lg w-100 w-md-auto" @onclick="DiscoverAsync" disabled="@loading">
            @(loading ? "Suche läuft …" : "Scanner suchen")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(error ? "alert-warning" : "alert-success")" role="alert">@message</div> }
    @if (result is null) { <div class="alert alert-info" role="status">Noch keine Suche ausgeführt.</div> }
    else if (result.Devices.Count == 0) { <div class="alert alert-warning" role="alert">@string.Join(" ", result.Diagnostics)</div> }
    else
    {
        @foreach (var diagnostic in result.Diagnostics) { <div class="alert alert-info" role="status">@diagnostic</div> }
        <fieldset class="row g-3 mb-3">
            <legend class="h4">Gefundene Scanner</legend>
            @foreach (var device in result.Devices)
            {
                <div class="col-12 col-md-6">
                    <label class="card h-100 scanner-choice @(selectedId == device.DiscoveryId ? "border-primary" : "")">
                        <div class="card-body">
                            <input type="radio" name="scanner" value="@device.DiscoveryId" checked="@(selectedId == device.DiscoveryId)" @onchange="() => selectedId = device.DiscoveryId" />
                            <strong class="ms-2">@device.DisplayName</strong>
                            <div class="mt-2"><span class="badge text-bg-secondary">@device.Protocol.ToUpperInvariant()</span> @device.IpAddress:@device.Port</div>
                        </div>
                    </label>
                </div>
            }
        </fieldset>
        <button class="btn btn-success btn-lg w-100" disabled="@(loading || selectedId is null)" @onclick="SelectAsync">Scanner auswählen</button>
    }

    @if (saneResult?.Succeeded == true)
    {
        <section class="card mt-4"><div class="card-body">
            <h2 class="h4">@saneResult.SelectedDevice!.DisplayName</h2>
            <div class="row g-3">
                <Capability Title="Einzugsquellen" Values="saneResult.Capabilities!.Sources" />
                <Capability Title="Formate" Values="saneResult.Capabilities.Formats" />
                <Capability Title="Auflösungen" Values="ResolutionLabels" />
                <Capability Title="Papiergrößen" Values="saneResult.Capabilities.PaperSizes" />
            </div>
        </div></section>
    }
</div>

@code {
    private ScannerNetworkDiscoveryResult? result;
    private ScannerDiscoveryResult? saneResult;
    private string? selectedId;
    private string? message;
    private bool error;
    private bool loading;
    private bool scannerLoading;
    private IReadOnlyList<SelectedScanner> savedScanners = [];
    private IReadOnlyList<string> availableSources = [];
    private long? activeScannerId;
    private string? activeDeviceId;
    private string scanSource = "";
    private ScanColorMode colorMode = ScanColorMode.Color;
    private int resolution = 300;
    private bool IsScanning => ScanWorkflow.Current?.IsActive == true;
    private bool finalBackIsBlank;
    private Guid? deleteCandidate;
    private Guid? loadedPreviewSession;
    private IJSObjectReference? notificationModule;
    private PaperlessMetadata? paperlessMetadata;
    private string? paperlessMessage;
    private bool paperlessError;
    private bool paperlessLoading;
    private string? paperlessTitle;
    private int? paperlessCorrespondent;
    private int? paperlessDocumentType;
    private readonly HashSet<int> paperlessTags = [];
    private string? DuplexSource => availableSources.FirstOrDefault(IsFeederSource);
    private bool HasAdf => !string.IsNullOrWhiteSpace(activeDeviceId) && DuplexSource is not null;
    private string ColorModeLabel => colorMode switch { ScanColorMode.Color => "Farbe", ScanColorMode.Grayscale => "Graustufen", _ => "Schwarzweiß" };
    private string DuplexStatusLabel => DuplexWorkflow.Current?.State switch { ManualDuplexState.AwaitingFlipConfirmation => "Stapel wenden", ManualDuplexState.PageCountMismatch => "Seitenzahlen stimmen nicht", ManualDuplexState.Completed => "Abgeschlossen", ManualDuplexState.Cancelled => "Abgebrochen", ManualDuplexState.Failed => "Fehlgeschlagen", _ => "Läuft" };
    private string DuplexStatusClass => DuplexWorkflow.Current?.State switch { ManualDuplexState.Completed => "alert-success", ManualDuplexState.PageCountMismatch or ManualDuplexState.Cancelled => "alert-warning", ManualDuplexState.Failed => "alert-danger", _ => "alert-info" };
    private string StatusLabel => ScanWorkflow.Current?.State switch { ScanJobState.Queued => "Eingereiht", ScanJobState.Running => "Läuft", ScanJobState.AwaitingUserDecision => "Rückfrage", ScanJobState.Completed => "Abgeschlossen", ScanJobState.Cancelled => "Abgebrochen", _ => "Fehlgeschlagen" };
    private string StatusClass => ScanWorkflow.Current?.State switch { ScanJobState.Completed => "alert-success", ScanJobState.Failed => "alert-danger", ScanJobState.Cancelled or ScanJobState.AwaitingUserDecision => "alert-warning", _ => "alert-info" };

    protected override async Task OnInitializedAsync()
    {
        ScanWorkflow.Changed += OnScanChanged;
        DuplexWorkflow.Changed += OnScanChanged;
        PageEditor.Changed += OnEditorChanged;
        PdfWorkflow.Changed += OnPdfChanged;
        UploadWorkflow.Changed += OnUploadChanged;
        savedScanners = await Discovery.GetSavedAsync(CancellationToken.None);
        var defaults = await Profiles.GetAsync(CancellationToken.None);
        colorMode = defaults.ColorMode; resolution = defaults.ResolutionDpi;
        paperlessTitle = defaults.Title; paperlessCorrespondent = defaults.CorrespondentId;
        paperlessDocumentType = defaults.DocumentTypeId; paperlessTags.UnionWith(defaults.TagIds);
        var validation = await Profiles.ValidateAsync(defaults, CancellationToken.None);
        if (!validation.IsValid) { error = true; message = string.Join(" ", validation.Errors) + " Bitte in den Einstellungen korrigieren."; }
        else if (defaults.ScannerId is { } scannerId)
        {
            await ActivateScannerAsync(scannerId);
            if (!string.IsNullOrWhiteSpace(defaults.Source)) scanSource = defaults.Source;
        }
        else if (savedScanners is [{ SaneDeviceId: not null } cached] && cached.Sources?.Count > 0)
            await ActivateScannerAsync(cached.Id);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        notificationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./scanNotifications.js");
    }
    private void OnScanChanged() => _ = InvokeAsync(async () =>
    {
        if (ScanWorkflow.Current is { State: ScanJobState.Completed } scan && loadedPreviewSession != scan.SessionId)
        { await SessionAccess.ClaimAsync(scan.SessionId); loadedPreviewSession = scan.SessionId; await PageEditor.LoadAsync(scan.SessionId, false); }
        if (DuplexWorkflow.Current is { State: ManualDuplexState.Completed } duplex && loadedPreviewSession != duplex.SessionId)
        { await SessionAccess.ClaimAsync(duplex.SessionId); loadedPreviewSession = duplex.SessionId; await PageEditor.LoadAsync(duplex.SessionId, true); }
        StateHasChanged(); await NotifyCurrentStateAsync();
    });
    private void OnEditorChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnPdfChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnUploadChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task LoadPaperlessAsync()
    {
        paperlessLoading = true;
        try { var loaded = await PaperlessClient.GetMetadataAsync(); paperlessMetadata = loaded.Metadata; paperlessMessage = loaded.Result.Message; paperlessError = !loaded.Result.Succeeded; }
        finally { paperlessLoading = false; }
    }
    private void ToggleTag(int id, ChangeEventArgs args) { if (args.Value is true) paperlessTags.Add(id); else paperlessTags.Remove(id); }
    private Task UploadAsync(Guid sessionId) => UploadWorkflow.UploadAsync(new(sessionId, paperlessTitle, paperlessCorrespondent, paperlessDocumentType, paperlessTags.ToArray()));
    private static string PageUrl(Guid sessionId, string fileName) => $"/api/scan-sessions/{sessionId:D}/pages/{Uri.EscapeDataString(fileName)}";
    private static string PdfUrl(Guid sessionId) => $"/api/scan-sessions/{sessionId:D}/document";
    private Task CreatePdfAsync() => PageEditor.Current is { } session ? PdfWorkflow.CreateAsync(session) : Task.CompletedTask;
    private Task CancelPdfAsync() => PdfWorkflow.CancelAsync();
    private string PdfStatusLabel => PdfWorkflow.Current?.State switch { PdfCreationState.Completed => "Fertig", PdfCreationState.Cancelled => "Abgebrochen", PdfCreationState.Failed => "Fehlgeschlagen", _ => "Läuft" };
    private string PdfStatusClass => PdfWorkflow.Current?.State switch { PdfCreationState.Completed => "alert-success", PdfCreationState.Cancelled => "alert-warning", PdfCreationState.Failed => "alert-danger", _ => "alert-info" };
    private void RequestDelete(Guid id) => deleteCandidate = id;
    private void CancelDelete() => deleteCandidate = null;
    private void ConfirmDelete(Guid id) { PageEditor.Delete(id); deleteCandidate = null; }
    private async Task StartScanAsync() => await ScanWorkflow.StartAsync(new(activeDeviceId!, scanSource, colorMode, resolution));
    private Task CancelScanAsync() => ScanWorkflow.CancelAsync();
    private Task ContinueScanAsync() => ScanWorkflow.ContinueAsync();
    private Task StartDuplexAsync() => DuplexWorkflow.StartAsync(new(activeDeviceId!, DuplexSource!, colorMode, resolution));
    private Task ConfirmFlipAsync() => DuplexWorkflow.ConfirmFlipAsync(finalBackIsBlank);
    private Task CancelDuplexAsync() => DuplexWorkflow.CancelAsync();
    private Task RestartDuplexAsync() => DuplexWorkflow.RestartAsync();
    private async Task NotifyCurrentStateAsync()
    {
        if (notificationModule is null) return;
        if (ScanWorkflow.Current is { } scan && scan.State is ScanJobState.AwaitingUserDecision or ScanJobState.Completed or ScanJobState.Failed)
            await ShowNotificationAsync(scan.SessionId, scan.State.ToString(), scan.State == ScanJobState.Completed ? "Scan abgeschlossen" : scan.State == ScanJobState.Failed ? "Scan fehlgeschlagen" : "Scan benötigt eine Rückmeldung", scan.Message);
        if (DuplexWorkflow.Current is { } duplex && duplex.State is ManualDuplexState.AwaitingFlipConfirmation or ManualDuplexState.PageCountMismatch or ManualDuplexState.Completed or ManualDuplexState.Failed)
            await ShowNotificationAsync(duplex.SessionId, duplex.State.ToString(), duplex.State == ManualDuplexState.AwaitingFlipConfirmation ? "Stapel wenden" : duplex.State == ManualDuplexState.Completed ? "Duplex-Scan abgeschlossen" : duplex.State == ManualDuplexState.Failed ? "Duplex-Scan fehlgeschlagen" : "Duplex-Scan benötigt eine Rückmeldung", duplex.Message);
    }
    private async Task ShowNotificationAsync(Guid sessionId, string state, string title, string message)
    { try { await notificationModule!.InvokeVoidAsync("show", title, message, $"{sessionId:N}:{state}"); } catch (JSDisconnectedException) { } }
    public async ValueTask DisposeAsync()
    {
        ScanWorkflow.Changed -= OnScanChanged; DuplexWorkflow.Changed -= OnScanChanged; PageEditor.Changed -= OnEditorChanged; PdfWorkflow.Changed -= OnPdfChanged; UploadWorkflow.Changed -= OnUploadChanged;
        if (notificationModule is not null) try { await notificationModule.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private void ChangeSource(ChangeEventArgs args) => scanSource = args.Value?.ToString() ?? "";
    private void ChangeColorMode(ChangeEventArgs args) { if (Enum.TryParse<ScanColorMode>(args.Value?.ToString(), out var value)) colorMode = value; }
    private void ChangeResolution(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var value)) resolution = value; }
    private static string SourceLabel(string source) => source.Contains("ADF", StringComparison.OrdinalIgnoreCase) || source.Contains("Feeder", StringComparison.OrdinalIgnoreCase) ? $"Automatischer Einzug ({source})" : $"Vorlagenglas ({source})";
    private static bool IsFeederSource(string source) => source.Contains("ADF", StringComparison.OrdinalIgnoreCase) || source.Contains("Feeder", StringComparison.OrdinalIgnoreCase);

    private async Task ActivateSelectedScannerAsync()
    { if (activeScannerId is { } id) await ActivateScannerAsync(id); }

    private async Task ActivateScannerAsync(long id)
    {
        message = null; scannerLoading = true;
        try
        {
            var activation = await Discovery.ActivateSavedAsync(id, CancellationToken.None);
            if (!activation.Succeeded) { error = true; message = activation.Diagnostic; return; }
            activeScannerId = id;
            if (!string.IsNullOrWhiteSpace(activation.Scanner!.SaneDeviceId) && activation.Scanner.Sources?.Count > 0)
            {
                ApplyProfile(activation.Scanner);
                error = false;
                message = $"{activation.Scanner.DisplayName} ist mit gespeicherten Scannerwerten bereit.";
                return;
            }
            await RefreshSaneAsync();
        }
        finally { scannerLoading = false; }
    }

    private async Task RefreshSaneAsync()
    {
        if (activeScannerId is not { } id) return;
        scannerLoading = true;
        try
        {
            saneResult = await Scanner.DiscoverAsync(CancellationToken.None);
            if (!saneResult.Succeeded || saneResult.SelectedDevice is null || saneResult.Capabilities is null)
            { error = true; message = saneResult.Diagnostic; activeDeviceId = null; availableSources = []; return; }
            var profile = await Discovery.SaveSaneProfileAsync(id, saneResult.SelectedDevice, saneResult.Capabilities, CancellationToken.None);
            savedScanners = savedScanners.Select(value => value.Id == id ? profile : value).ToArray();
            ApplyProfile(profile);
            error = false;
            message = $"Scannerwerte für {profile.DisplayName} wurden aktualisiert.";
        }
        finally { scannerLoading = false; }
    }

    private void ApplyProfile(SelectedScanner scanner)
    {
        activeDeviceId = scanner.SaneDeviceId;
        availableSources = scanner.Sources ?? [];
        scanSource = availableSources.FirstOrDefault(value => value.Contains("ADF", StringComparison.OrdinalIgnoreCase) || value.Contains("Feeder", StringComparison.OrdinalIgnoreCase))
            ?? availableSources.FirstOrDefault() ?? "";
        if (scanner.Resolutions?.Contains(300) != true) resolution = scanner.Resolutions?.FirstOrDefault() ?? 300;
    }
    private IReadOnlyList<string> ResolutionLabels => saneResult?.Capabilities?.Resolutions.Select(value => $"{value} dpi").ToArray() ?? [];

    private async Task DiscoverAsync()
    {
        loading = true; message = null; selectedId = null;
        try { result = await Discovery.DiscoverAsync(CancellationToken.None); }
        finally { loading = false; }
    }

    private async Task SelectAsync()
    {
        loading = true; message = null;
        try
        {
            var selection = await Discovery.SelectAsync(selectedId!, CancellationToken.None);
            error = !selection.Succeeded;
            message = selection.Succeeded ? selection.Diagnostic ?? $"{selection.Scanner!.DisplayName} wurde geprüft und gespeichert." : selection.Diagnostic;
            if (selection.Succeeded)
            {
                savedScanners = await Discovery.GetSavedAsync(CancellationToken.None);
                await ActivateScannerAsync(selection.Scanner!.Id);
                message = selection.Diagnostic ?? $"{selection.Scanner.DisplayName} wurde geprüft und gespeichert und ist für den Scan aktiviert.";
            }
        }
        finally { loading = false; }
    }
}
