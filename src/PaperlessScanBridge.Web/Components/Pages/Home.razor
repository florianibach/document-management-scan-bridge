@page "/"
@using PaperlessScanBridge.Application.Scanning
@using PaperlessScanBridge.Application.Documents
@using PaperlessScanBridge.Application.Paperless
@using PaperlessScanBridge.Application.Profiles
@inject IScannerDiscoveryService Discovery
@inject IScanner Scanner
@inject ISimplexScanWorkflow ScanWorkflow
@inject IManualDuplexWorkflow DuplexWorkflow
@inject IPageEditingSession PageEditor
@inject IPdfCreationWorkflow PdfWorkflow
@inject IPaperlessClient PaperlessClient
@inject IPaperlessUploadWorkflow UploadWorkflow
@inject IProfileDefaultsService Profiles
@inject IProfileServiceConfigurationService ServiceConfiguration
@inject IScanSessionAccessService SessionAccess
@inject IScanBatchWorkflow BatchWorkflow
@inject ICurrentProfileAccessor CurrentProfile
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Scan</PageTitle>
<header class="page-heading"><h1>Scan</h1><p>Prepare, capture, review, and safely send a document.</p></header>
<WorkflowStepper Current="@CurrentWorkflowStep" DocumentNumber="@ActiveBatchDocumentNumber" DocumentCount="@ActiveBatchDocumentCount" />
@if (CurrentWorkflowStep == "Prepare" && !string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info" role="status">@message</div> }
@if (CurrentWorkflowStep == "Prepare")
{
<section class="card mt-4 scan-panel">
 <div class="card-body">
  <span class="badge text-bg-primary mb-2">Simplex</span>
  <h2 class="h3">Scan a document</h2>
  <p>Capture one page from the flatbed or multiple one-sided pages from the feeder.</p>
  @if (savedScanners.Count == 0)
  {
   <div class="setup-prompt card border-primary" role="status"><div class="card-body"><h3 class="h4">No scanner selected yet</h3><p>Find a compatible eSCL/AirScan scanner on your network before starting a scan.</p><a class="btn btn-primary btn-lg w-100" href="/scanner-setup">Set up a scanner</a></div></div>
  }
  else
  {
   <div class="mb-3"><label class="form-label" for="saved-scanner">Saved scanner</label><select id="saved-scanner" class="form-select form-select-lg" @bind="activeScannerId" @bind:after="ActivateSelectedScannerAsync" disabled="@(IsScanning || scannerLoading)"><option value="">Select a scanner …</option>@foreach (var scanner in savedScanners) { <option value="@scanner.Id">@scanner.DisplayName (@scanner.IpAddress)</option> }</select></div>
   @if (activeScannerId is null) { <div class="alert alert-info">Select a scanner to load its current sources and scan options.</div> }
   @if (scannerLoading) { <div class="alert alert-info d-flex align-items-center gap-2" role="status" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>SANE is locating the scanner and reading its options with <code>scanimage</code> …</span></div> }
  }
  @if (!string.IsNullOrWhiteSpace(activeDeviceId))
  {
  @if (ActiveScanner is { } prepared)
  {
  <section class="prepare-summary mb-3" aria-labelledby="prepare-summary-title"><h3 id="prepare-summary-title" class="h5">Ready to scan</h3><dl class="row mb-0"><dt class="col-5">Scanner</dt><dd class="col-7">@prepared.DisplayName</dd><dt class="col-5">Last validated</dt><dd class="col-7">@prepared.ValidatedAt.ToLocalTime().ToString("g")</dd><dt class="col-5">Scan mode</dt><dd class="col-7">Simplex or manual duplex</dd><dt class="col-5">Source</dt><dd class="col-7">@SourceLabel(scanSource)</dd><dt class="col-5">Color</dt><dd class="col-7">@ColorModeLabel</dd><dt class="col-5">Resolution</dt><dd class="col-7">@resolution dpi</dd><dt class="col-5">Values</dt><dd class="col-7">@(valuesFromDefaults ? "Profile defaults" : "Current scanner settings")</dd></dl></section>
  }
  <button class="btn btn-outline-secondary w-100 mb-3" @onclick="RefreshSaneAsync" disabled="@(IsScanning || scannerLoading)">Refresh scanner capabilities</button>
  <div class="row g-3">
   <div class="col-12 col-md-4"><label class="form-label" for="source">Source</label><select id="source" class="form-select form-select-lg" value="@scanSource" @onchange="ChangeSource" disabled="@(IsScanning || availableSources.Count == 0)">@foreach (var source in availableSources) { <option value="@source" selected="@(source == scanSource)">@SourceLabel(source)</option> }</select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="color">Color mode</label><select id="color" class="form-select form-select-lg" value="@colorMode" @onchange="ChangeColorMode" disabled="@IsScanning"><option value="Color" selected="@(colorMode == ScanColorMode.Color)">Color</option><option value="Grayscale" selected="@(colorMode == ScanColorMode.Grayscale)">Grayscale</option><option value="BlackAndWhite" selected="@(colorMode == ScanColorMode.BlackAndWhite)">Black and white</option></select></div>
   <div class="col-12 col-md-4"><label class="form-label" for="resolution">Resolution</label><select id="resolution" class="form-select form-select-lg" value="@resolution" @onchange="ChangeResolution" disabled="@IsScanning"><option value="100" selected="@(resolution == 100)">100 dpi</option><option value="200" selected="@(resolution == 200)">200 dpi</option><option value="300" selected="@(resolution == 300)">300 dpi</option><option value="600" selected="@(resolution == 600)">600 dpi</option></select></div>
  </div>
  }
  @if (savedScanners.Count > 0)
  { <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="StartScanAsync" disabled="@(IsScanning || DuplexWorkflow.Current?.IsActive == true || string.IsNullOrWhiteSpace(activeDeviceId) || string.IsNullOrWhiteSpace(scanSource))">@(IsScanning ? "Scanning …" : "Start simplex scan")</button> }
  @if (ScanWorkflow.Current?.State == ScanJobState.AwaitingUserDecision)
  {
   <button class="btn btn-success btn-lg w-100 mt-2" @onclick="ContinueScanAsync">Scanner is still working — keep waiting</button>
   <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Cancel scan now</button>
  }
  else if (IsScanning) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Cancel scan now</button> }
  @if (ScanWorkflow.Current is { } job) { <div class="alert @StatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@StatusLabel:</strong> @job.Message</div> }
 </div>
</section>

<section class="card mt-4 scan-panel duplex-panel">
 <div class="card-body">
  <span class="badge text-bg-success mb-2">Manual duplex</span>
  <h2 class="h3">Scan a two-sided document</h2>
  <p>Two controlled feeder passes are automatically combined in reading order.</p>
  @if (!HasAdf)
  {
   <div class="alert alert-warning">Select a scanner with an automatic feeder for manual duplex.</div>
  }
  else
  {
   <div class="alert alert-info mb-3"><strong>Settings used:</strong> Automatic feeder (@DuplexSource), @ColorModeLabel, @resolution dpi. The color and resolution values selected above apply to both passes.</div>
  }
  @if (HasAdf && DuplexWorkflow.Current?.State == ManualDuplexState.AwaitingFlipConfirmation)
  {
   <div class="flip-instruction" role="status" aria-live="polite">
    <div class="flip-icon" aria-hidden="true">↶</div>
    <h3 class="h4">Flip the stack now</h3>
    <ol><li>Remove the complete stack from the output tray.</li><li>Flip the stack as one unit — do not change its order.</li><li>Reload it with the unscanned side in the same feed direction.</li></ol>
   </div>
   <div class="form-check my-3"><input id="blank-back" class="form-check-input" type="checkbox" @bind="finalBackIsBlank"><label class="form-check-label" for="blank-back">The final back side of the document is blank</label></div>
   <button class="btn btn-success btn-lg w-100" @onclick="ConfirmFlipAsync">Stack is ready — scan back sides</button>
   <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelDuplexAsync">Cancel duplex scan</button>
  }
  else if (HasAdf)
  {
   <button class="btn btn-success btn-lg w-100" @onclick="StartDuplexAsync" disabled="@(!HasAdf || IsScanning || DuplexWorkflow.Current?.IsActive == true)">@(DuplexWorkflow.Current?.IsActive == true ? "Duplex-Scanning …" : "Start manual duplex scan")</button>
   @if (DuplexWorkflow.Current?.State is ManualDuplexState.ScanningFronts or ManualDuplexState.ScanningBacks) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelDuplexAsync">Cancel duplex scan</button> }
   @if (DuplexWorkflow.Current?.State == ManualDuplexState.PageCountMismatch) { <button class="btn btn-warning btn-lg w-100 mt-2" @onclick="RestartDuplexAsync">Check stack and restart</button> }
  }
  @if (DuplexWorkflow.Current is { } duplex) { <div class="alert @DuplexStatusClass mt-3 mb-0" role="status" aria-live="polite"><strong>@DuplexStatusLabel:</strong> @duplex.Message</div> }
 </div>
</section>
}

@if (CurrentWorkflowStep == "Scan")
{
 <AppStateCard Kind="loading" Title="Scan running" Message="The scanner is working. Keep this browser window open." Loading="true">
  <ChildContent>
   @if (ScanWorkflow.Current?.State == ScanJobState.AwaitingUserDecision)
   {
    <button class="btn btn-primary btn-lg w-100" @onclick="ContinueScanAsync">Scanner is still working — keep waiting</button>
    <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelScanAsync">Cancel scan now</button>
   }
   else if (DuplexWorkflow.Current?.State == ManualDuplexState.AwaitingFlipConfirmation)
   {
    <p><strong>Flip the stack now:</strong> flip it as one unit, keep its order, and reload it in the same feed direction.</p>
    <button class="btn btn-success btn-lg w-100" @onclick="ConfirmFlipAsync">Scan back sides</button>
    <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="CancelDuplexAsync">Cancel duplex scan</button>
   }
   else
   {
    <p class="mb-2">@(ScanWorkflow.Current?.Message ?? DuplexWorkflow.Current?.Message)</p>
    <button class="btn btn-outline-danger btn-lg w-100" @onclick="CancelActiveScanAsync">Cancel scan now</button>
   }
  </ChildContent>
 </AppStateCard>
}

@if (CurrentWorkflowStep == "Review" && PageEditor.Current is { } preview)
{
 <section class="card mt-4 preview-panel" aria-labelledby="preview-title">
  <div class="card-body">
   <h2 id="preview-title" class="h3">@(ActiveBatchDocument is { } activeReview ? $"Review document {activeReview.Number} of {ActiveBatchDocumentCount}" : "Review, edit, and split pages")</h2>
   <p>@(ActiveBatchDocument is null ? "Add a grey document boundary wherever a new document should begin. Rotations and removals remain attached to their pages." : $"This document contains {ActiveBatchDocument.Pages.Count} page(s). Review it before continuing to its PDF step.")</p>
   @if (preview.Pages.Count == 0)
   {
    <div class="alert alert-warning" role="status">@preview.Message</div>
   }
   else
   {
    <div class="preview-grid @(ActiveBatchDocument is null ? "split-layout" : "document-layout")">
     @foreach (var scannedPage in VisibleReviewPages)
     {
      <article class="preview-page" aria-label="@("Page " + scannedPage.Number)">
       <h3 class="h5">Page @scannedPage.Number</h3>
       @if (scannedPage.IsAvailable)
       {
        <div class="preview-image-frame"><img loading="lazy" src="@PageUrl(preview.SessionId, scannedPage.FileName)" alt="@("Vorschau von Page " + scannedPage.Number)" style="transform: rotate(@(scannedPage.RotationDegrees)deg)" /></div>
        <button class="btn btn-outline-primary w-100 mt-2" @onclick="() => PageEditor.Rotate(scannedPage.Id)" aria-label="@("Page um 90 Grad rotate")">↻ 90° rotate</button>
       }
       else
       {
        <div class="alert alert-warning" role="alert">@scannedPage.Error</div>
       }
       @if (deleteCandidate == scannedPage.Id)
       {
        <div class="d-flex gap-2 mt-2"><button class="btn btn-danger flex-fill" @onclick="() => ConfirmDelete(scannedPage.Id)">Confirm removal</button><button class="btn btn-outline-secondary flex-fill" @onclick="CancelDelete">Cancel</button></div>
       }
       else
       {
        <button class="btn btn-outline-danger w-100 mt-2" @onclick="() => RequestDelete(scannedPage.Id)">Remove page …</button>
       }
      </article>
      @if (ActiveBatchDocument is null && scannedPage.Number < preview.Pages.Count)
      {
       var hasSplit = BatchWorkflow.Current?.SplitPoints.Contains(scannedPage.Number) == true;
       <button class="split-control @(hasSplit ? "is-split" : null)" @onclick="() => ToggleSplitAsync(scannedPage.Id)" aria-pressed="@hasSplit" aria-label="@(hasSplit ? "Remove document boundary after page " + scannedPage.Number : "Split document after page " + scannedPage.Number)">
        <span class="split-line" aria-hidden="true"></span><span class="split-label">@(hasSplit ? "✓ Boundary" : "+ Split here")</span><span class="split-line" aria-hidden="true"></span>
       </button>
      }
     }
    </div>
    @if (BatchWorkflow.Current is { } batch && ActiveBatchDocument is null)
    {
     <section class="batch-summary mt-4" aria-labelledby="batch-title">
      <h3 id="batch-title" class="h4">@batch.Documents.Count documents from @batch.PageCount pages</h3>
      <p aria-live="polite">@batch.CompletedCount sent · @(batch.Documents.Count - batch.CompletedCount) remaining. Each document will proceed through Review, PDF, and Send.</p>
      @foreach (var document in batch.Documents)
      {
       <article class="card mb-3 batch-document"><div class="card-body">
        <h4 class="h5">Document @document.Number · @document.Pages.Count page(s) @if (document.State == BatchDocumentState.Uploaded) { <span class="badge text-bg-success">Sent</span> }</h4>
        <p class="mb-0">Pages @string.Join(", ", document.Pages.Select(page => page.Number))</p>
       </div></article>
      }
      <button class="btn btn-primary btn-lg w-100" @onclick="BeginBatchDocuments">Continue with document @(NextBatchDocument?.Number ?? 1)</button>
     </section>
    }
    @if (ActiveBatchDocument is { } documentToReview)
    { <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="() => CreateBatchPdfAsync(documentToReview.Id)" disabled="@(documentToReview.Pages.Any(page => !page.IsAvailable))">Continue to PDF</button> }
    <button class="btn btn-outline-secondary btn-lg w-100 mt-2" @onclick="ShowPreparation">Back to preparation</button>
    @if (PdfWorkflow.Current?.IsActive == true)
    {
     <button class="btn btn-outline-danger w-100 mt-2" @onclick="CancelPdfAsync">Cancel PDF creation</button>
    }
   }
  </div>
 </section>
}
else if (CurrentWorkflowStep == "Review")
{
 <AppStateCard Kind="success" Title="Scan completed" Message="@(ScanWorkflow.Current?.Message ?? DuplexWorkflow.Current?.Message ?? "The pages are being prepared for review.")">
  <ChildContent><span aria-live="polite">Completed</span></ChildContent>
 </AppStateCard>
}

@if (CurrentWorkflowStep == "PDF" && ActiveBatchDocument is { } batchPdf)
{
 <AppStateCard Kind="@(batchPdf.State == BatchDocumentState.Failed ? "error" : batchPdf.State == BatchDocumentState.Ready ? "success" : "loading")" Title="@($"PDF · document {batchPdf.Number} of {ActiveBatchDocumentCount}")" Message="@(batchPdf.Message ?? "Preparing this document PDF …")" Loading="@(batchPdf.State == BatchDocumentState.CreatingPdf)">
  <ChildContent>
   @if (batchPdf.State == BatchDocumentState.Ready)
   { <a class="btn btn-outline-success btn-lg w-100" href="@BatchPdfUrl(PageEditor.Current!.SessionId, batchPdf.Id)">Download PDF</a><button class="btn btn-primary btn-lg w-100 mt-2" @onclick="ShowBatchSend">Continue to Send</button> }
   else if (batchPdf.State == BatchDocumentState.Failed)
   { <button class="btn btn-primary btn-lg w-100" @onclick="() => CreateBatchPdfAsync(batchPdf.Id)">Retry PDF creation</button> }
   <button class="btn btn-outline-secondary btn-lg w-100 mt-2" @onclick="ShowBatchReview">Back to review</button>
  </ChildContent>
 </AppStateCard>
}
else if (CurrentWorkflowStep == "PDF" && PdfWorkflow.Current is { } currentPdf)
{
 <AppStateCard Kind="@(currentPdf.State == PdfCreationState.Failed ? "error" : "loading")" Title="Creating PDF" Message="@currentPdf.Message" Loading="@currentPdf.IsActive">
  <ChildContent>
   @if (currentPdf.IsActive) { <button class="btn btn-outline-danger btn-lg w-100" @onclick="CancelPdfAsync">Cancel PDF creation</button> }
   <button class="btn btn-outline-secondary btn-lg w-100 mt-2" @onclick="ShowReview">Back to review</button>
  </ChildContent>
 </AppStateCard>
}

@if (CurrentWorkflowStep == "Send" && ActiveBatchDocument is { } batchSend)
{
 <section class="card mt-4"><div class="card-body">
  <span class="badge text-bg-primary mb-2">Document @batchSend.Number of @ActiveBatchDocumentCount</span>
  <h2 class="h3">Send to Paperless-ngx</h2>
  @if (batchSend.State == BatchDocumentState.Uploaded)
  {
   <AppStateCard Kind="success" Title="Document submitted" Message="@(batchSend.Message ?? "Paperless accepted the document.")">
    <ChildContent>
     @if (!string.IsNullOrWhiteSpace(batchSend.TaskId)) { <p class="small">Paperless task ID: @batchSend.TaskId</p> }
     <div class="alert alert-info mt-3" role="status" data-testid="paperless-processing-hint">
      <strong>Paperless may still be processing this document.</strong> Processing can take some time. Check <strong>File Tasks</strong> in Paperless-ngx for progress.
     </div>
     <a class="btn btn-outline-success w-100" href="@BatchPdfUrl(PageEditor.Current!.SessionId, batchSend.Id)">Download PDF</a>
     @if (NextBatchDocument is not null) { <button class="btn btn-primary btn-lg w-100 mt-2" @onclick="ContinueNextBatchDocument">Review next document (@NextBatchDocument.Number of @ActiveBatchDocumentCount)</button> }
     else { <button class="btn btn-primary btn-lg w-100 mt-2" @onclick="StartNewDocument">Finish batch and scan another</button> }
    </ChildContent>
   </AppStateCard>
  }
  else
  {
   <a class="btn btn-outline-success btn-lg w-100" href="@BatchPdfUrl(PageEditor.Current!.SessionId, batchSend.Id)">Download PDF</a>
   @if (paperlessMetadata is null) { <button class="btn btn-outline-primary btn-lg w-100 mt-2" @onclick="LoadPaperlessAsync">Load Paperless metadata</button> }
   @if (paperlessError && !string.IsNullOrWhiteSpace(paperlessMessage))
   { <div class="alert alert-danger mt-3 paperless-operation-error" role="alert" aria-live="assertive"><strong>Metadata for document @batchSend.Number could not be loaded.</strong> @paperlessMessage @if (!string.IsNullOrWhiteSpace(paperlessDiagnosticId)) { <div class="mt-2">Diagnostic ID: <code>@paperlessDiagnosticId</code></div> }<div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-danger" @onclick="LoadPaperlessAsync">Retry metadata</button>@if (NeedsPaperlessSettings(paperlessFailure)) { <a class="btn btn-outline-danger" href="/settings#paperless-connection">Open Paperless settings</a> }<button class="btn btn-outline-secondary" @onclick="DismissMetadataError">Dismiss</button></div></div> }
   else if (paperlessMetadata is not null)
   {
    <label class="form-label mt-3" for="batch-title-@batchSend.Id">Title (optional)</label><input id="batch-title-@batchSend.Id" class="form-control form-control-lg" value="@batchSend.Metadata.Title" @onchange="args => SetBatchTitleAsync(batchSend.Id, args.Value?.ToString())" />
    <label class="form-label mt-3" for="batch-correspondent-@batchSend.Id">Correspondent</label><select id="batch-correspondent-@batchSend.Id" class="form-select form-select-lg" value="@batchSend.Metadata.CorrespondentId" @onchange="args => SetBatchCorrespondentAsync(batchSend.Id, args.Value?.ToString())"><option value="">Do not set</option>@foreach (var choice in paperlessMetadata.Correspondents) { <option value="@choice.Id">@choice.Name</option> }</select>
    <label class="form-label mt-3" for="batch-type-@batchSend.Id">Document type</label><select id="batch-type-@batchSend.Id" class="form-select form-select-lg" value="@batchSend.Metadata.DocumentTypeId" @onchange="args => SetBatchTypeAsync(batchSend.Id, args.Value?.ToString())"><option value="">Do not set</option>@foreach (var choice in paperlessMetadata.DocumentTypes) { <option value="@choice.Id">@choice.Name</option> }</select>
    <fieldset class="mt-3"><legend class="h6">Tags</legend>@foreach (var choice in paperlessMetadata.Tags) { <label class="form-check"><input class="form-check-input" type="checkbox" checked="@batchSend.Metadata.Tags.Contains(choice.Id)" @onchange="args => ToggleBatchTagAsync(batchSend.Id, choice.Id, args.Value is true)" /> @choice.Name</label> }</fieldset>
    <button class="btn btn-success btn-lg w-100 mt-3" @onclick="() => UploadBatchAsync(batchSend.Id)">@(batchSend.State == BatchDocumentState.Failed ? "Retry send" : "Send to Paperless")</button>
   }
   @if (batchSend.State == BatchDocumentState.Failed && !string.IsNullOrWhiteSpace(batchSend.Message))
   {
    <div class="alert alert-danger mt-3 paperless-operation-error" role="alert" aria-live="assertive">
     <strong>Document @batchSend.Number was not sent.</strong> @batchSend.Message
     @if (!string.IsNullOrWhiteSpace(batchSend.DiagnosticId)) { <div class="mt-2">Diagnostic ID: <code>@batchSend.DiagnosticId</code></div> }
     <div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-danger" @onclick="() => UploadBatchAsync(batchSend.Id)">Retry send</button>@if (NeedsPaperlessSettings(batchSend.Failure)) { <a class="btn btn-outline-danger" href="/settings#paperless-connection">Open Paperless settings</a> }<button class="btn btn-outline-secondary" @onclick="() => BatchWorkflow.DismissUploadErrorAsync(batchSend.Id)">Dismiss</button></div>
    </div>
   }
   else if (!string.IsNullOrWhiteSpace(batchSend.Message)) { <div class="alert alert-info mt-3">@batchSend.Message</div> }
   <button class="btn btn-outline-secondary btn-lg w-100 mt-2" @onclick="ShowBatchReview">Back to review</button>
  }
 </div></section>
}
else if (CurrentWorkflowStep == "Send" && PdfWorkflow.Current is { State: PdfCreationState.Completed } completedPdf)
{
 <section class="card mt-4"><div class="card-body">
  <span class="badge text-bg-success mb-2">PDF ready</span>
  <h2 class="h3">Send to Paperless-ngx</h2>
  @if (UploadWorkflow.Current is { State: PaperlessUploadState.Accepted } acceptedUpload && acceptedUpload.SessionId == completedPdf.SessionId)
  {
   <AppStateCard Kind="success" Title="Document submitted" Message="@acceptedUpload.Message">
    <ChildContent>
     @if (!string.IsNullOrWhiteSpace(acceptedUpload.TaskId)) { <p class="small">Paperless task ID: @acceptedUpload.TaskId</p> }
     <div class="alert alert-info mt-3" role="status" data-testid="paperless-processing-hint">
      <strong>Paperless may still be processing this document.</strong> Processing can take some time. Check <strong>File Tasks</strong> in Paperless-ngx for progress.
     </div>
     <button class="btn btn-primary btn-lg w-100" @onclick="StartNewDocument">New document</button>
     @if (PaperlessHomeUrl is not null) { <a class="btn btn-outline-primary btn-lg w-100 mt-2" href="@PaperlessHomeUrl" target="_blank" rel="noopener noreferrer">Open Paperless</a> }
     <a class="btn btn-outline-success w-100 mt-2" href="@PdfUrl(completedPdf.SessionId)">Download PDF</a>
    </ChildContent>
   </AppStateCard>
  }
  else
  {
  <a class="btn btn-outline-success btn-lg w-100" href="@PdfUrl(completedPdf.SessionId)">Download PDF</a>
  <button class="btn btn-outline-primary btn-lg w-100 mt-2" @onclick="LoadPaperlessAsync" disabled="@paperlessLoading">@(paperlessLoading ? "Checking connection …" : "Check connection and load metadata")</button>
  @if (paperlessError && !string.IsNullOrWhiteSpace(paperlessMessage))
  {
   <div class="alert alert-danger mt-2 paperless-operation-error" role="alert" aria-live="assertive"><strong>Paperless metadata could not be loaded.</strong> @paperlessMessage
    @if (!string.IsNullOrWhiteSpace(paperlessDiagnosticId)) { <div class="mt-2">Diagnostic ID: <code>@paperlessDiagnosticId</code></div> }
    <div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-danger" @onclick="LoadPaperlessAsync">Retry metadata</button>@if (NeedsPaperlessSettings(paperlessFailure)) { <a class="btn btn-outline-danger" href="/settings#paperless-connection">Open Paperless settings</a> }<button class="btn btn-outline-secondary" @onclick="DismissMetadataError">Dismiss</button></div>
   </div>
  }
  else if (!string.IsNullOrWhiteSpace(paperlessMessage)) { <div class="alert alert-success mt-2" role="status">@paperlessMessage</div> }
  @if (paperlessMetadata is not null)
  {
   <div class="mt-3"><label class="form-label" for="paperless-title">Title (optional)</label><input id="paperless-title" class="form-control form-control-lg" maxlength="256" @bind="paperlessTitle" /></div>
   <div class="mt-3"><label class="form-label" for="send-correspondent">Correspondent (optional)</label><select id="send-correspondent" class="form-select form-select-lg" @bind="paperlessCorrespondent"><option value="">Do not set</option>@foreach (var choice in paperlessMetadata.Correspondents) { <option value="@choice.Id">@choice.Name</option> }</select></div>
   <div class="mt-3"><label class="form-label" for="send-type">Document type (optional)</label><select id="send-type" class="form-select form-select-lg" @bind="paperlessDocumentType"><option value="">Do not set</option>@foreach (var choice in paperlessMetadata.DocumentTypes) { <option value="@choice.Id">@choice.Name</option> }</select></div>
   <fieldset class="mt-3"><legend class="h6">Tags (optional)</legend>@foreach (var choice in paperlessMetadata.Tags) { <div class="form-check"><input class="form-check-input" id="send-tag-@choice.Id" type="checkbox" checked="@paperlessTags.Contains(choice.Id)" @onchange="args => ToggleTag(choice.Id, args)" /><label class="form-check-label" for="send-tag-@choice.Id">@choice.Name</label></div> }</fieldset>
   <button class="btn btn-success btn-lg w-100 mt-3" @onclick="() => UploadAsync(completedPdf.SessionId)" disabled="@(UploadWorkflow.Current?.IsActive == true || UploadWorkflow.Current is { State: PaperlessUploadState.Accepted, SessionId: var acceptedSession } && acceptedSession == completedPdf.SessionId)">Send to Paperless</button>
  }
  @if (UploadWorkflow.Current is { State: PaperlessUploadState.Failed } upload)
  { <div class="alert alert-danger mt-3 paperless-operation-error" role="alert" aria-live="assertive"><strong>The document was not sent.</strong> @upload.Message @if (!string.IsNullOrWhiteSpace(upload.DiagnosticId)) { <div class="mt-2">Diagnostic ID: <code>@upload.DiagnosticId</code></div> }<div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-danger" @onclick="() => UploadAsync(completedPdf.SessionId)">Retry send</button>@if (NeedsPaperlessSettings(upload.Failure)) { <a class="btn btn-outline-danger" href="/settings#paperless-connection">Open Paperless settings</a> }<button class="btn btn-outline-secondary" @onclick="UploadWorkflow.DismissError">Dismiss</button></div></div> }
  else if (UploadWorkflow.Current is { } uploadStatus) { <div class="alert @(uploadStatus.State == PaperlessUploadState.Accepted ? "alert-success" : "alert-info") mt-3" role="status">@uploadStatus.Message</div> }
  <button class="btn btn-outline-secondary btn-lg w-100 mt-3" @onclick="ShowReview">Back to review</button>
  @if (UploadWorkflow.Current?.IsActive == true) { <button class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="UploadWorkflow.CancelAsync">Send abbrechen</button> }
  }
 </div></section>
}


