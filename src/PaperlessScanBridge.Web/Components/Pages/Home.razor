    private async Task NotifyCurrentStateAsync()
    {
        if (notificationModule is null) return;
        if (ScanWorkflow.Current is { } cancellingScan && cancellingScan.SessionId == cancellingScanSessionId)
        {
            if (cancellingScan.State == ScanJobState.Cancelled)
                await ShowNotificationAsync(cancellingScan.SessionId, cancellingScan.State.ToString(), "Scan cancelled", cancellingScan.Message);
            return;
        }
        if (DuplexWorkflow.Current is { } cancellingDuplex && cancellingDuplex.SessionId == cancellingDuplexSessionId)
        {
            if (cancellingDuplex.State == ManualDuplexState.Cancelled)
                await ShowNotificationAsync(cancellingDuplex.SessionId, cancellingDuplex.State.ToString(), "Duplex-Scan cancelled", cancellingDuplex.Message);
            return;
        }
        if (ScanWorkflow.Current is { } scan && scan.State is ScanJobState.AwaitingUserDecision or ScanJobState.Completed or ScanJobState.Failed)
        {
            var eventName = scan.State == ScanJobState.AwaitingUserDecision
                ? $"{scan.State}:{scan.TimeoutDecisionNumber}"
                : scan.State.ToString();
            var notificationMessage = scan.State == ScanJobState.AwaitingUserDecision
                ? "The scan is still running. Return to Scan Bridge to keep waiting or cancel the scan."
                : scan.Message;
            await ShowNotificationAsync(scan.SessionId, eventName, scan.State == ScanJobState.Completed ? "Scan completed" : scan.State == ScanJobState.Failed ? "Scan failed" : "Scan needs a decision", notificationMessage);
        }
        if (DuplexWorkflow.Current is { } duplex && duplex.State is ManualDuplexState.AwaitingFlipConfirmation or ManualDuplexState.PageCountMismatch or ManualDuplexState.Completed or ManualDuplexState.Failed)
            await ShowNotificationAsync(duplex.SessionId, duplex.State.ToString(), duplex.State == ManualDuplexState.AwaitingFlipConfirmation ? "Flip the stack" : duplex.State == ManualDuplexState.Completed ? "Duplex scan completed" : duplex.State == ManualDuplexState.Failed ? "Duplex scan failed" : "Duplex scan needs a decision", duplex.Message);
    }
    private async Task ShowNotificationAsync(Guid sessionId, string state, string title, string message)
    { try { await notificationModule!.InvokeVoidAsync("show", title, message, $"{sessionId:N}:{state}"); } catch (JSDisconnectedException) { } }
    public async ValueTask DisposeAsync()
    {
        ScanWorkflow.Changed -= OnScanChanged; DuplexWorkflow.Changed -= OnScanChanged; PageEditor.Changed -= OnEditorChanged; PdfWorkflow.Changed -= OnPdfChanged; UploadWorkflow.Changed -= OnUploadChanged;
        if (notificationModule is not null) try { await notificationModule.DisposeAsync(); } catch (JSDisconnectedException) { }
