    private async Task CreateBatchPdfAsync(Guid documentId)
    { activeBatchDocumentId = documentId; displayedStep = "PDF"; await BatchWorkflow.CreatePdfAsync(documentId); }
    private void ShowBatchReview() => displayedStep = "Review";
    private void ShowBatchSend() => displayedStep = "Send";
    private void ContinueNextBatchDocument() { activeBatchDocumentId = NextBatchDocument?.Id; displayedStep = "Review"; paperlessMessage = null; }
    private async Task UploadBatchAsync(Guid documentId)
