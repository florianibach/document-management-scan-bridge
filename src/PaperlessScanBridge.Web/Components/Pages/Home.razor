    private Task CancelPdfAsync() => PdfWorkflow.CancelAsync();
    private void ShowReview() => displayedStep = "Review";
    private void ShowPreparation() => displayedStep = "Prepare";
    private void StartNewDocument() { displayedStep = "Prepare"; activeBatchDocumentId = null; paperlessMetadata = null; paperlessMessage = null; }
    private Task CancelActiveScanAsync() => ScanWorkflow.Current?.IsActive == true ? CancelScanAsync() : CancelDuplexAsync();
    private string PdfStatusLabel => PdfWorkflow.Current?.State switch { PdfCreationState.Completed => "Ready", PdfCreationState.Cancelled => "Cancelled", PdfCreationState.Failed => "Failed", _ => "Running" };
    private string PdfStatusClass => PdfWorkflow.Current?.State switch { PdfCreationState.Completed => "alert-success", PdfCreationState.Cancelled => "alert-warning", PdfCreationState.Failed => "alert-danger", _ => "alert-info" };
