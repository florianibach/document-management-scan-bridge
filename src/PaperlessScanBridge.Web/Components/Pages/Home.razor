    private string DuplexStatusClass => DuplexWorkflow.Current?.State switch { ManualDuplexState.Completed => "alert-success", ManualDuplexState.PageCountMismatch or ManualDuplexState.Cancelled => "alert-warning", ManualDuplexState.Failed => "alert-danger", _ => "alert-info" };
    private string StatusLabel => ScanWorkflow.Current?.State switch { ScanJobState.Queued => "Queued", ScanJobState.Running => "Running", ScanJobState.AwaitingUserDecision => "Decision needed", ScanJobState.Completed => "Completed", ScanJobState.Cancelled => "Cancelled", _ => "Failed" };
    private string StatusClass => ScanWorkflow.Current?.State switch { ScanJobState.Completed => "alert-success", ScanJobState.Failed => "alert-danger", ScanJobState.Cancelled or ScanJobState.AwaitingUserDecision => "alert-warning", _ => "alert-info" };

    protected override async Task OnInitializedAsync()
    {
        ScanWorkflow.Changed += OnScanChanged;
        DuplexWorkflow.Changed += OnScanChanged;
        PageEditor.Changed += OnEditorChanged;
        PdfWorkflow.Changed += OnPdfChanged;
        UploadWorkflow.Changed += OnUploadChanged;
        savedScanners = await Discovery.GetSavedAsync(CancellationToken.None);
        var defaults = await Profiles.GetAsync(CancellationToken.None);
        paperlessBaseUrl = (await ServiceConfiguration.GetEffectiveAsync(CancellationToken.None)).BaseUrl;
        colorMode = defaults.ColorMode; resolution = defaults.ResolutionDpi; valuesFromDefaults = defaults.ScannerId is not null;
        paperlessTitle = defaults.Title; paperlessCorrespondent = defaults.CorrespondentId;
        paperlessDocumentType = defaults.DocumentTypeId; paperlessTags.UnionWith(defaults.TagIds);
        var validation = await Profiles.ValidateAsync(defaults, CancellationToken.None);
        if (!validation.IsValid) { message = string.Join(" ", validation.Errors) + " Please correct this in Settings."; }
        else if (defaults.ScannerId is { } scannerId)
        {
            await ActivateScannerAsync(scannerId);
            if (!string.IsNullOrWhiteSpace(defaults.Source)) scanSource = defaults.Source;
        }
        else if (savedScanners is [{ SaneDeviceId: not null } cached] && cached.Sources?.Count > 0)
            await ActivateScannerAsync(cached.Id);
        if (PageEditor.Current is { } existingPages)
            await BatchWorkflow.LoadAsync(existingPages, (await CurrentProfile.GetRequiredAsync()).Id);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        notificationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./scanNotifications.js");
    }
    private void OnScanChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        await NotifyCurrentStateAsync();
        if (ScanWorkflow.Current is { State: ScanJobState.Completed } scan && loadedPreviewSession != scan.SessionId)
        { await SessionAccess.ClaimAsync(scan.SessionId); loadedPreviewSession = scan.SessionId; await PageEditor.LoadAsync(scan.SessionId, false); }
        if (DuplexWorkflow.Current is { State: ManualDuplexState.Completed } duplex && loadedPreviewSession != duplex.SessionId)
        { await SessionAccess.ClaimAsync(duplex.SessionId); loadedPreviewSession = duplex.SessionId; await PageEditor.LoadAsync(duplex.SessionId, true); }
        if (PageEditor.Current is { } pages && BatchWorkflow.Current?.SessionId != pages.SessionId)
        { var profile = await CurrentProfile.GetRequiredAsync(); await BatchWorkflow.LoadAsync(pages, profile.Id); }
        StateHasChanged();
    });
    private void OnEditorChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnPdfChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnUploadChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task LoadPaperlessAsync()
    {
        paperlessLoading = true;
        try { var loaded = await PaperlessClient.GetMetadataAsync(); paperlessMetadata = loaded.Metadata; paperlessMessage = loaded.Result.Message; paperlessError = !loaded.Result.Succeeded; paperlessFailure = loaded.Result.Failure; paperlessDiagnosticId = loaded.Result.DiagnosticId; }
        finally { paperlessLoading = false; }
    }
    private void DismissMetadataError() { paperlessMessage = null; paperlessDiagnosticId = null; paperlessError = false; }
    private static bool NeedsPaperlessSettings(PaperlessFailure failure) => failure is PaperlessFailure.Configuration or PaperlessFailure.Authentication or PaperlessFailure.Authorization;
    private void ToggleTag(int id, ChangeEventArgs args) { if (args.Value is true) paperlessTags.Add(id); else paperlessTags.Remove(id); }
    private Task UploadAsync(Guid sessionId) => UploadWorkflow.UploadAsync(new(sessionId, paperlessTitle, paperlessCorrespondent, paperlessDocumentType, paperlessTags.ToArray()));
    private static string PageUrl(Guid sessionId, string fileName) => $"/api/scan-sessions/{sessionId:D}/pages/{Uri.EscapeDataString(fileName)}";
    private static string PdfUrl(Guid sessionId) => $"/api/scan-sessions/{sessionId:D}/document";
    private static string BatchPdfUrl(Guid sessionId, Guid documentId) => $"/api/scan-sessions/{sessionId:D}/documents/{documentId:D}";
    private Task ToggleSplitAsync(Guid pageId) => BatchWorkflow.ToggleSplitAfterAsync(pageId);
    private Task SetBatchTitleAsync(Guid documentId, string? title)
    { var document = BatchWorkflow.Current!.Documents.Single(value => value.Id == documentId); return BatchWorkflow.SetMetadataAsync(documentId, document.Metadata with { Title = title }); }
    private Task SetBatchCorrespondentAsync(Guid id, string? value)
    { var document = BatchWorkflow.Current!.Documents.Single(item => item.Id == id); return BatchWorkflow.SetMetadataAsync(id, document.Metadata with { CorrespondentId = int.TryParse(value, out var parsed) ? parsed : null }); }
    private Task SetBatchTypeAsync(Guid id, string? value)
    { var document = BatchWorkflow.Current!.Documents.Single(item => item.Id == id); return BatchWorkflow.SetMetadataAsync(id, document.Metadata with { DocumentTypeId = int.TryParse(value, out var parsed) ? parsed : null }); }
    private Task ToggleBatchTagAsync(Guid id, int tag, bool selected)
    { var document = BatchWorkflow.Current!.Documents.Single(item => item.Id == id); var tags = document.Metadata.Tags.ToHashSet(); if (selected) tags.Add(tag); else tags.Remove(tag); return BatchWorkflow.SetMetadataAsync(id, document.Metadata with { TagIds = tags.ToArray() }); }
    private void BeginBatchDocuments()
    {
        activeBatchDocumentId = NextBatchDocument?.Id ?? BatchWorkflow.Current?.Documents.FirstOrDefault()?.Id;
        displayedStep = "Review";
