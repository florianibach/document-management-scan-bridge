@page "/"
@using PaperlessScanBridge.Application.Scanning
@inject IScanner Scanner
@rendermode InteractiveServer

<PageTitle>Scanner prüfen</PageTitle>

<div class="container-fluid px-0">
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-body-tertiary">
        <span class="badge text-bg-primary mb-3">Scannerdiagnose</span>
        <h1 class="display-6 fw-bold">Netzwerkscanner prüfen</h1>
        <p class="lead">Sucht SANE-kompatible Geräte und zeigt die verfügbaren Einzugsquellen und Papieroptionen.</p>
        <button class="btn btn-primary btn-lg" @onclick="DiscoverAsync" disabled="@loading">
            @(loading ? "Suche läuft …" : "Scanner suchen")
        </button>
    </div>

    @if (result is null)
    {
        <div class="alert alert-info" role="status">Noch keine Suche ausgeführt.</div>
    }
    else if (!result.Succeeded)
    {
        <div class="alert alert-warning" role="alert"><strong>Prüfung nicht erfolgreich:</strong> @result.Diagnostic</div>
        @if (result.Devices.Count > 0)
        {
            <p>@result.Devices.Count Gerät(e) gefunden. Bitte die Scanner-Konfiguration prüfen.</p>
        }
    }
    else
    {
        <section class="card" aria-labelledby="scanner-heading">
            <div class="card-body">
                <h2 id="scanner-heading" class="h4">@result.SelectedDevice!.DisplayName</h2>
                <p class="text-body-secondary"><code>@result.SelectedDevice.Identifier</code></p>
                <div class="row g-3">
                    <Capability Title="Einzugsquellen" Values="result.Capabilities!.Sources" />
                    <Capability Title="Formate" Values="result.Capabilities.Formats" />
                    <Capability Title="Auflösungen" Values="ResolutionLabels" />
                    <Capability Title="Papiergrößen" Values="result.Capabilities.PaperSizes" />
                </div>
            </div>
        </section>
    }
</div>

@code {
    private ScannerDiscoveryResult? result;
    private bool loading;
    private IReadOnlyList<string> ResolutionLabels => result?.Capabilities?.Resolutions.Select(value => $"{value} dpi").ToArray() ?? [];

    private async Task DiscoverAsync()
    {
        loading = true;
        try { result = await Scanner.DiscoverAsync(CancellationToken.None); }
        finally { loading = false; }
    }
}
