@using PaperlessScanBridge.Application.Profiles
@inject Microsoft.Extensions.Options.IOptions<ProfileOptions> Options
@inject ICurrentProfileAccessor CurrentProfile

@if (profile is not null)
{
 <div class="profile-context small" role="status">
  <span><span class="text-body-secondary">Profil:</span> @profile.DisplayName</span>
  @if (Options.Value.Mode == ProfileMode.OpenIdConnect)
  { <form method="post" action="/signout" class="d-inline ms-2"><button class="btn btn-sm btn-outline-secondary">Abmelden</button></form> }
 </div>
}

@code {
    private UserProfile? profile;
    protected override async Task OnInitializedAsync() => profile = await CurrentProfile.GetRequiredAsync();
}
