@using PaperlessScanBridge.Application.Scanning
@inject IScannerDiscoveryService Discovery
@inject IScanner Scanner

<section class="card scanner-setup-card" aria-labelledby="scanner-setup-title">
 <div class="card-body">
  <h2 id="scanner-setup-title" class="h4">Set up a scanner</h2>
  <p>Find compatible eSCL/AirScan devices on your local network. Your current scanner will not change until another device passes validation.</p>
  <button class="btn btn-primary btn-lg w-100" @onclick="DiscoverAsync" disabled="@busy">
   @if (discovering) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }@(discovering ? "Searching for scanners …" : "Search for scanners")
  </button>

  @if (discovering)
  {
   <div class="alert alert-info mt-3" role="status" aria-live="polite">Searching the local network for compatible scanners.</div>
  }
  @if (result is not null && !discovering)
  {
   @if (result.Devices.Count == 0)
   {
    <AppStateCard Kind="warning" Title="No scanners found" Message="Make sure the scanner is switched on, connected to the same network, and then try again.">
     <ChildContent><button class="btn btn-outline-primary w-100" @onclick="DiscoverAsync">Try again</button></ChildContent>
     <TechnicalDetails>@string.Join(" ", result.Diagnostics)</TechnicalDetails>
    </AppStateCard>
   }
   else
   {
    @if (result.Diagnostics.Any(value => value.Contains("both HTTP and HTTPS", StringComparison.OrdinalIgnoreCase)))
    { <div class="alert alert-info mt-3" role="status">Duplicate advertisements for the same physical device were merged. HTTPS will be tried first.</div> }
    <div class="mt-3" aria-labelledby="found-scanners-title">
     <h3 id="found-scanners-title" class="h5">Discovered scanners</h3>
     <div class="row g-3">
      @foreach (var device in result.Devices)
      {
       <div class="col-12 col-lg-6">
        <article class="card h-100 scanner-choice @(validatingId == device.DiscoveryId ? "border-primary" : "")">
         <div class="card-body d-flex flex-column">
          <h4 class="h5">@device.DisplayName</h4>
          <p class="text-body-secondary mb-2">eSCL available · @device.Protocol.ToUpperInvariant() preferred</p>
          @if (validatingId == device.DiscoveryId)
          { <div class="alert alert-info" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@(loadingSaneCapabilities ? "Reading scanner backend capabilities …" : "Validating scanner capabilities …")</div> }
          <button class="btn btn-success btn-lg w-100 mt-auto" disabled="@busy" @onclick="() => SelectAsync(device.DiscoveryId)">Select and validate</button>
         </div>
        </article>
       </div>
      }
     </div>
    </div>
   }
  }

  @if (selection is { Succeeded: true, Scanner: { } scanner })
  {
   <AppStateCard Kind="success" Title="Scanner selected" Message="@SuccessMessage(scanner, selection.Diagnostic)">
    <ChildContent><a class="btn btn-primary w-100" href="/">Return to scan preparation</a></ChildContent>
   </AppStateCard>
  }
  else if (selection is { Succeeded: false })
  {
   <AppStateCard Kind="error" Title="This scanner could not be validated" Message="@UserFailure(selection)">
    <ChildContent><button class="btn btn-outline-primary w-100" @onclick="() => SelectAsync(lastAttemptedId!)">Try again</button><a class="btn btn-outline-secondary w-100 mt-2" href="/status">Open diagnostics</a></ChildContent>
    <TechnicalDetails>@selection.Diagnostic</TechnicalDetails>
   </AppStateCard>
  }
 </div>
</section>

@code {
 [Parameter] public EventCallback<SelectedScanner> ScannerReady { get; set; }
 private ScannerNetworkDiscoveryResult? result;
 private ScannerSelectionResult? selection;
 private string? validatingId, lastAttemptedId;
 private bool discovering, loadingSaneCapabilities;
 private bool busy => discovering || validatingId is not null;

 private async Task DiscoverAsync()
 {
  discovering = true; selection = null;
  try { result = await Discovery.DiscoverAsync(default); }
  finally { discovering = false; }
 }

 private async Task SelectAsync(string discoveryId)
 {
  validatingId = discoveryId; lastAttemptedId = discoveryId; selection = null;
  try
  {
   selection = await Discovery.SelectAsync(discoveryId, default);
   if (selection is not { Succeeded: true, Scanner: { } selected }) return;

   loadingSaneCapabilities = true;
   var sane = await Scanner.DiscoverAsync(default);
   if (!sane.Succeeded || sane.SelectedDevice is null || sane.Capabilities is null)
   {
    selection = selection with { Diagnostic = sane.Diagnostic ?? "The scanner backend did not return usable capabilities." };
    return;
   }

   var ready = await Discovery.SaveSaneProfileAsync(selected.Id, sane.SelectedDevice, sane.Capabilities, default);
   selection = selection with { Scanner = ready };
   await ScannerReady.InvokeAsync(ready);
  }
  finally { loadingSaneCapabilities = false; validatingId = null; }
 }

 private static string SuccessMessage(SelectedScanner scanner, string? diagnostic) =>
  diagnostic is null ? $"{scanner.DisplayName} passed capability validation and is ready to use. HTTPS was preferred." : $"{scanner.DisplayName} is ready to use. {diagnostic}";

 private static string UserFailure(ScannerSelectionResult value) => value.Failure switch
 {
  ScannerEndpointFailure.InvalidCapabilities or ScannerEndpointFailure.InvalidXml => "The device responded, but its scanner capabilities could not be read. Your current scanner is unchanged.",
  ScannerEndpointFailure.HttpStatus => "The device was found, but it does not provide compatible eSCL scanner capabilities. Your current scanner is unchanged.",
  ScannerEndpointFailure.Timeout => "The scanner took too long to respond. It may be busy or temporarily unavailable. Your current scanner is unchanged.",
  _ => "The scanner was found, but the connection could not be validated. Check that it is available and try again. Your current scanner is unchanged."
 };
}
