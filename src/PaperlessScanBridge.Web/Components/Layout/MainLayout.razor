@inherits LayoutComponentBase
@inject BuildInformation Build

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-body-secondary small" title="Git commit">Version <code>@Build.Commit</code></span>
        </div>

        <article class="content px-4">
            <ProfileBanner />
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
